---
export type TravelSpot = {
  id: string;
  name: string;
  countries: string[];
  region?: string;
  area: string;
  kind: string;
  access: string;
  scores: {
    globallyUnique: number;
    laymenInterest: number;
    easeOfAccess: number;
    lowTouristCrowds: number;
  };
  uniqueness: string;
  why: string;
  realityCheck: string;
  wikiUrl?: string;
  source?: {
    label: string;
    url: string;
  };
  map: {
    name: string;
    formattedAddress?: string;
    placeId?: string;
    rating?: number;
    reviewCount?: number;
    query?: string;
    location: { lat: number; lng: number };
    googleMapsUrl: string;
  };
  trip: {
    days: number;
    costUsd: number;
    note: string;
  };
};

type Props = {
  pageTitle: string;
  pageDescription: string;
  subject: string;
  keywords: string;
  eyebrow: string;
  dek: string;
  criteriaText?: string;
  tripOriginLabel: string;
  mapHeading: string;
  mapAriaLabel: string;
  mapCenter: { lat: number; lng: number };
  mapZoom: number;
  mapErrorLabel: string;
  spots: TravelSpot[];
  showMap?: boolean;
  mapEngine?: "google" | "polar-south";
  themeColorLight?: string;
  themeColorDark?: string;
};

const {
  pageTitle,
  pageDescription,
  subject,
  keywords,
  eyebrow,
  dek,
  tripOriginLabel,
  mapHeading,
  mapAriaLabel,
  mapCenter,
  mapZoom,
  mapErrorLabel,
  spots,
  showMap = true,
  mapEngine = "google",
  themeColorLight = "#fcfaf6",
  themeColorDark = "#15120e",
} = Astro.props;

const siteUrl =
  (Astro.site?.toString() ?? "https://sokolsky.me").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const usesPolarMap = mapEngine === "polar-south";
const googleMapsApiKey =
  showMap && !usesPolarMap
    ? (import.meta.env.GOOGLE_MAPS_API_KEY_PUBLIC ??
      process.env.GOOGLE_MAPS_API_KEY_PUBLIC ??
      "")
    : "";
const showMapCanvas = showMap && (usesPolarMap || Boolean(googleMapsApiKey));

const getScoreTotal = (spot: TravelSpot) =>
  spot.scores.globallyUnique +
  spot.scores.laymenInterest +
  spot.scores.easeOfAccess +
  spot.scores.lowTouristCrowds;
const scoreEntries = [
  ["Globally unique", "globallyUnique"],
  ["Laymen interest", "laymenInterest"],
  ["Ease of access", "easeOfAccess"],
  ["Low tourist crowds", "lowTouristCrowds"],
] as const;
const validateScore = (spot: TravelSpot, key: keyof TravelSpot["scores"]) => {
  const score = spot.scores[key];
  if (!Number.isInteger(score) || score < 0 || score > 10) {
    throw new Error(`${pageTitle} spot "${spot.id}" has invalid ${key} score.`);
  }
};
const getGoogleMapsUrl = (spot: TravelSpot) => {
  const query =
    spot.map.query ??
    [spot.map.name || spot.name, spot.map.formattedAddress, ...spot.countries]
      .filter(Boolean)
      .join(", ");
  const params = new URLSearchParams({ api: "1", query });

  if (spot.map.placeId) {
    params.set("query_place_id", spot.map.placeId);
  }

  return `https://www.google.com/maps/search/?${params.toString()}`;
};

spots.forEach((spot) => {
  scoreEntries.forEach(([, key]) => validateScore(spot, key));
});

const rankedSpotsWithTrip = spots
  .map((spot, originalIndex) => ({
    ...spot,
    originalIndex,
    totalScore: getScoreTotal(spot),
    googleMapsUrl: getGoogleMapsUrl(spot),
  }))
  .sort(
    (a, b) =>
      b.totalScore - a.totalScore ||
      b.scores.laymenInterest - a.scores.laymenInterest ||
      a.originalIndex - b.originalIndex,
  );
const spotIds = new Set(rankedSpotsWithTrip.map((spot) => spot.id));

if (spotIds.size !== rankedSpotsWithTrip.length) {
  throw new Error(`${pageTitle} spot IDs must be unique.`);
}

const formatter = new Intl.NumberFormat("en-US");
const usdFormatter = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});
const getLocationValues = (spot: TravelSpot) =>
  (spot.region ? spot.region.split("/") : spot.countries)
    .map((location) => location.trim())
    .filter(Boolean);
const usesRegionFilter = rankedSpotsWithTrip.every((spot) => Boolean(spot.region));
const locationFilterLabel = usesRegionFilter ? "State" : "Country";
const locationFilterAllLabel = usesRegionFilter ? "All states" : "All countries";
const locationCounts = new Map<string, number>();

rankedSpotsWithTrip.forEach((spot) => {
  getLocationValues(spot).forEach((location) => {
    locationCounts.set(location, (locationCounts.get(location) ?? 0) + 1);
  });
});

const locationOptions = [...locationCounts.entries()]
  .map(([value, count]) => ({ value, label: `${value} (${formatter.format(count)})` }))
  .sort((a, b) => a.value.localeCompare(b.value));
const tripEstimateLabel = `${tripOriginLabel.replace(/^From /, "From-")} trip estimate`;
const kindOptions = [...new Set(rankedSpotsWithTrip.map((spot) => spot.kind))].sort((a, b) =>
  a.localeCompare(b),
);
const spotMapData = rankedSpotsWithTrip.map((spot, index) => ({
  id: spot.id,
  rank: index + 1,
  name: spot.name,
  kind: spot.kind,
  locations: getLocationValues(spot),
  uniqueness: spot.uniqueness,
  totalScore: spot.totalScore,
  scores: spot.scores,
  position: spot.map.location,
  googleMapsUrl: spot.googleMapsUrl,
}));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  numberOfItems: rankedSpotsWithTrip.length,
  itemListElement: rankedSpotsWithTrip.map((spot, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "TouristAttraction",
      name: spot.name,
      description: spot.why,
      sameAs: spot.googleMapsUrl,
      geo: {
        "@type": "GeoCoordinates",
        latitude: spot.map.location.lat,
        longitude: spot.map.location.lng,
      },
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="subject" content={subject} />
    <meta name="application-name" content={pageTitle} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta name="keywords" content={keywords} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={themeColorLight} />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="msapplication-TileColor" content={themeColorDark} />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color={themeColorDark} />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Nikita Sokolsky" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    {usesPolarMap && (
      <>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@10.6.1/ol.css" />
        <script is:inline src="https://cdn.jsdelivr.net/npm/proj4@2.19.7/dist/proj4.js"></script>
        <script is:inline src="https://cdn.jsdelivr.net/npm/ol@10.6.1/dist/ol.js"></script>
      </>
    )}
  </head>
  <body>
    <main class="page">
      <header class="hero">
        <a class="home-link" href="/">sokolsky.me</a>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{pageTitle}</h1>
        <p class="dek">{dek}</p>
      </header>

      {showMap && (
        <section class="map-section" aria-labelledby="map-heading">
          <div class="map-copy">
            <p class="eyebrow">Map</p>
            <h2 id="map-heading">{mapHeading}</h2>
            <p id="map-status" class="map-status">
              Showing all {rankedSpotsWithTrip.length} spots.
            </p>
          </div>
          {showMapCanvas ? (
            <>
              <div
                id="spots-map"
                class:list={["spots-map", usesPolarMap && "spots-map-polar"]}
                aria-label={mapAriaLabel}
              ></div>
              {usesPolarMap && (
                <div id="polar-popup" class="polar-popup" hidden>
                  <button type="button" class="polar-popup-close" aria-label="Close popup">
                    ×
                  </button>
                  <div id="polar-popup-content"></div>
                </div>
              )}
            </>
          ) : (
            <p class="map-unavailable">
              Map unavailable because the Google Maps public key is not configured.
            </p>
          )}
        </section>
      )}

      <section class="toolbar" aria-label="Spot filters">
        <label class="filter-field" for="location-filter">
          <span>{locationFilterLabel}</span>
          <select id="location-filter" autocomplete="off">
            <option value="">{locationFilterAllLabel}</option>
            {locationOptions.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </label>
        <label class="filter-field" for="kind-filter">
          <span>Type</span>
          <select id="kind-filter" autocomplete="off">
            <option value="">All types</option>
            {kindOptions.map((kind) => <option value={kind}>{kind}</option>)}
          </select>
        </label>
        <label class="filter-field" for="sort-select">
          <span>Sort</span>
          <select id="sort-select" autocomplete="off">
            <option value="score">Total score</option>
            <option value="globallyUnique">Globally unique</option>
            <option value="laymenInterest">Laymen interest</option>
            <option value="easeOfAccess">Ease of access</option>
            <option value="lowTouristCrowds">Low tourist crowds</option>
            <option value="popularity">Popularity (GMaps reviews)</option>
            <option value="cost">Cost (low to high)</option>
            <option value="time">Time required (short to long)</option>
          </select>
        </label>
        <button id="reset-filters" class="reset-button" type="button">Reset</button>
      </section>

      <section class="spot-list" aria-label={subject}>
        {rankedSpotsWithTrip.map((spot, index) => (
          <article
            id={spot.id}
            class="spot-card"
            data-location-list={getLocationValues(spot).join("|")}
            data-kind={spot.kind}
            data-cost-usd={spot.trip.costUsd}
            data-trip-days={spot.trip.days}
            data-review-count={spot.map.reviewCount ?? 0}
            data-score-rank={index + 1}
            data-total-score={spot.totalScore}
            data-globally-unique={spot.scores.globallyUnique}
            data-laymen-interest={spot.scores.laymenInterest}
            data-ease-of-access={spot.scores.easeOfAccess}
            data-low-tourist-crowds={spot.scores.lowTouristCrowds}
          >
            <div class="spot-rank" aria-label={`Rank ${index + 1}`}>
              {String(index + 1).padStart(2, "0")}
            </div>
            <div class="spot-body">
              <div class="spot-heading">
                <div>
                  <p class="spot-area">{spot.area}</p>
                  <h2>
                    {spot.wikiUrl ? (
                      <a
                        class="spot-title-link"
                        href={spot.wikiUrl}
                        target="_blank"
                        rel="noreferrer noopener"
                      >
                        {spot.name}
                      </a>
                    ) : (
                      spot.name
                    )}
                  </h2>
                </div>
                <a
                  class="maps-link"
                  href={spot.googleMapsUrl}
                  target="_blank"
                  rel="noreferrer noopener"
                >
                  Open map
                </a>
              </div>
              <div class="badges" aria-label={`${spot.name} attributes`}>
                <span>{spot.kind}</span>
                <span>{spot.region ?? spot.countries.join(" / ")}</span>
                <span>{spot.access}</span>
                <span>
                  {tripOriginLabel}: {spot.trip.days} days · {usdFormatter.format(spot.trip.costUsd)}
                </span>
                {typeof spot.map.rating === "number" && (
                  <span>
                    GMaps {spot.map.rating.toFixed(1)} · {formatter.format(spot.map.reviewCount ?? 0)} reviews
                  </span>
                )}
              </div>
              <div class="score-panel" aria-label={`${spot.name} ranking scores`}>
                <div class="score-total">
                  <span>Total score</span>
                  <strong>{spot.totalScore}/40</strong>
                </div>
                <dl class="score-grid">
                  {scoreEntries.map(([label, key]) => (
                    <div>
                      <dt>{label}</dt>
                      <dd>{spot.scores[key]}/10</dd>
                    </div>
                  ))}
                </dl>
              </div>
              <p class="uniqueness">{spot.uniqueness}</p>
              <p>{spot.why}</p>
              <p class="reality-check">{spot.realityCheck}</p>
              <p class="trip-estimate">
                <strong>{tripEstimateLabel}:</strong> {spot.trip.days} days · {usdFormatter.format(spot.trip.costUsd)}. {spot.trip.note}
              </p>
              {spot.source && (
                <p class="source-link">
                  Source: <a href={spot.source.url} target="_blank" rel="noreferrer noopener">{spot.source.label}</a>
                </p>
              )}
            </div>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>

<script is:inline define:vars={{ googleMapsApiKey, spotMapData, mapCenter, mapZoom, mapErrorLabel, mapEngine }}>
  if (googleMapsApiKey && mapEngine !== "polar-south") {
    ((g) => {
      let h;
      let a;
      let k;
      const p = "The Google Maps JavaScript API";
      const c = "google";
      const l = "importLibrary";
      const q = "__ib__";
      const m = document;
      let b = window;
      b = b[c] || (b[c] = {});
      const d = b.maps || (b.maps = {});
      const r = new Set();
      const e = new URLSearchParams();
      const u = () =>
        h ||
        (h = new Promise(async (resolve, reject) => {
          await (a = m.createElement("script"));
          e.set("libraries", [...r] + "");
          for (k in g) {
            e.set(k.replace(/[A-Z]/g, (t) => `_${t[0].toLowerCase()}`), g[k]);
          }
          e.set("callback", `${c}.maps.${q}`);
          a.src = `https://maps.${c}apis.com/maps/api/js?${e}`;
          d[q] = resolve;
          a.onerror = () => (h = reject(Error(`${p} could not load.`)));
          a.nonce = m.querySelector("script[nonce]")?.nonce || "";
          m.head.append(a);
        }));
      d[l] ? console.warn(`${p} only loads once. Ignoring:`, g) : (d[l] = (f, ...n) => r.add(f) && u().then(() => d[l](f, ...n)));
    })({
      key: googleMapsApiKey,
      v: "weekly",
    });
  }

  const locationFilter = document.querySelector("#location-filter");
  const kindFilter = document.querySelector("#kind-filter");
  const sortSelect = document.querySelector("#sort-select");
  const resetFiltersButton = document.querySelector("#reset-filters");
  const spotList = document.querySelector(".spot-list");
  const spotCards = [...document.querySelectorAll(".spot-card")];
  const mapElement = document.querySelector("#spots-map");
  const mapStatus = document.querySelector("#map-status");
  const markerRecords = [];
  let spotsMap;
  let infoWindow;
  let polarOverlay;
  let polarProjection;

  const escapeHtml = (value) =>
    String(value).replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[character]);

  const popupHtml = (spot) =>
    `<strong>${escapeHtml(spot.rank)}. ${escapeHtml(spot.name)}</strong><br>${escapeHtml(spot.uniqueness)}<br><a href="${escapeHtml(spot.googleMapsUrl)}" target="_blank" rel="noreferrer noopener">Open in Google Maps</a>`;

  const getVisibleSpots = (selectedLocation, selectedKind) =>
    spotMapData.filter(
      (spot) =>
        (!selectedLocation || spot.locations.includes(selectedLocation)) &&
        (!selectedKind || spot.kind === selectedKind),
    );

  const updateMapStatus = (selectedLocation, selectedKind) => {
    if (!mapStatus) return;

    const visibleCount = getVisibleSpots(selectedLocation, selectedKind).length;
    const label = visibleCount === 1 ? "spot" : "spots";
    const filterLabel = [selectedLocation, selectedKind].filter(Boolean).join(" · ");
    mapStatus.textContent = filterLabel
      ? `Showing ${visibleCount} ${label} for ${filterLabel}.`
      : `Showing all ${visibleCount} ${label}.`;
  };

  const polarCoordinate = (position) =>
    ol.proj.fromLonLat([position.lng, position.lat], polarProjection);

  const fitMapToMarkers = (visibleRecords) => {
    if (!spotsMap || visibleRecords.length === 0) return;

    if (mapEngine === "polar-south") {
      if (visibleRecords.length === 1) {
        spotsMap.getView().setCenter(polarCoordinate(visibleRecords[0].spot.position));
        spotsMap.getView().setZoom(5);
        return;
      }

      const extent = ol.extent.boundingExtent(
        visibleRecords.map((record) => polarCoordinate(record.spot.position)),
      );
      spotsMap.getView().fit(ol.extent.buffer(extent, 180000), {
        padding: [36, 36, 36, 36],
        maxZoom: 5,
        duration: 0,
      });
      return;
    }

    if (!window.google?.maps) return;

    if (visibleRecords.length === 1) {
      spotsMap.setCenter(visibleRecords[0].spot.position);
      spotsMap.setZoom(8);
      return;
    }

    const bounds = new google.maps.LatLngBounds();
    for (const { spot } of visibleRecords) {
      bounds.extend(spot.position);
    }
    spotsMap.fitBounds(bounds, 42);
  };

  const syncMapMarkers = (selectedLocation, selectedKind) => {
    updateMapStatus(selectedLocation, selectedKind);
    if (!spotsMap) return;

    const visibleIds = new Set(
      getVisibleSpots(selectedLocation, selectedKind).map((spot) => spot.id),
    );
    const visibleRecords = [];

    for (const record of markerRecords) {
      const isVisible = visibleIds.has(record.spot.id);
      if (mapEngine === "polar-south") {
        record.feature.set("hidden", !isVisible);
        record.feature.changed();
      } else {
        record.marker.setMap(isVisible ? spotsMap : null);
      }
      if (isVisible) visibleRecords.push(record);
    }

    fitMapToMarkers(visibleRecords);
  };

  const getNumberData = (element, key) => Number(element.dataset[key] ?? 0);

  const sortedSpotCards = () => {
    const selectedSort = sortSelect?.value ?? "score";

    return [...spotCards].sort((a, b) => {
      const scoreDelta =
        getNumberData(b, "totalScore") - getNumberData(a, "totalScore") ||
        getNumberData(b, "laymenInterest") - getNumberData(a, "laymenInterest") ||
        getNumberData(a, "scoreRank") - getNumberData(b, "scoreRank");

      if (
        ["globallyUnique", "laymenInterest", "easeOfAccess", "lowTouristCrowds"].includes(
          selectedSort,
        )
      ) {
        const selectedScoreDelta =
          getNumberData(b, selectedSort) - getNumberData(a, selectedSort);

        return selectedScoreDelta || scoreDelta;
      }

      if (selectedSort === "popularity") {
        const popularityDelta =
          getNumberData(b, "reviewCount") - getNumberData(a, "reviewCount");

        return popularityDelta || scoreDelta;
      }

      if (selectedSort === "cost") {
        const costDelta = getNumberData(a, "costUsd") - getNumberData(b, "costUsd");

        return costDelta || scoreDelta;
      }

      if (selectedSort === "time") {
        const timeDelta = getNumberData(a, "tripDays") - getNumberData(b, "tripDays");

        return timeDelta || scoreDelta;
      }

      return scoreDelta;
    });
  };

  const syncCardOrderAndRanks = () => {
    const sortedCards = sortedSpotCards();
    let visibleIndex = 0;

    for (const card of sortedCards) {
      spotList?.append(card);

      if (card.hidden) continue;

      visibleIndex += 1;
      const rank = card.querySelector(".spot-rank");
      if (!rank) continue;

      rank.textContent = String(visibleIndex).padStart(2, "0");
      rank.setAttribute("aria-label", `Display rank ${visibleIndex}`);
    }
  };

  const applyFilters = () => {
    const selectedLocation = locationFilter?.value ?? "";
    const selectedKind = kindFilter?.value ?? "";

    for (const card of spotCards) {
      const locations = card.dataset.locationList?.split("|") ?? [];
      const locationMismatch =
        Boolean(selectedLocation) && !locations.includes(selectedLocation);
      const kindMismatch =
        Boolean(selectedKind) && card.dataset.kind !== selectedKind;
      card.hidden = locationMismatch || kindMismatch;
    }

    syncCardOrderAndRanks();
    syncMapMarkers(selectedLocation, selectedKind);
  };

  const initPolarMap = () => {
    if (!mapElement || !window.ol || !window.proj4) {
      throw new Error("Polar map libraries did not load.");
    }

    const half = 12367396.2185;
    const extent = [-half, -half, half, half];
    const tileSize = 512;
    const maxZoom = 7;
    const tileStyle = window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "gbif-dark"
      : "gbif-geyser";

    proj4.defs(
      "EPSG:3031",
      "+proj=stere +lat_0=-90 +lat_ts=-71 +lon_0=0 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs",
    );
    ol.proj.proj4.register(proj4);

    polarProjection = new ol.proj.Projection({
      code: "EPSG:3031",
      units: "m",
      extent,
      worldExtent: [-180, -90, 180, 0],
    });
    ol.proj.addProjection(polarProjection);

    const popupElement = document.querySelector("#polar-popup");
    const popupContent = document.querySelector("#polar-popup-content");
    polarOverlay = new ol.Overlay({
      element: popupElement,
      autoPan: { animation: { duration: 180 } },
      positioning: "bottom-center",
      offset: [0, -14],
    });

    popupElement?.querySelector(".polar-popup-close")?.addEventListener("click", () => {
      polarOverlay.setPosition(undefined);
      popupElement.hidden = true;
    });

    const markerStyle = (feature) => {
      if (feature.get("hidden")) return undefined;
      const rank = String(feature.get("rank"));
      return new ol.style.Style({
        image: new ol.style.Circle({
          radius: 13,
          fill: new ol.style.Fill({ color: "#8a4b2a" }),
          stroke: new ol.style.Stroke({ color: "#fffaf2", width: 2 }),
        }),
        text: new ol.style.Text({
          text: rank,
          fill: new ol.style.Fill({ color: "#fffaf2" }),
          font: "700 12px ui-sans-serif, system-ui, sans-serif",
        }),
      });
    };

    const vectorSource = new ol.source.Vector();

    spotsMap = new ol.Map({
      target: mapElement,
      layers: [
        new ol.layer.Tile({
          source: new ol.source.XYZ({
            projection: polarProjection,
            tileGrid: new ol.tilegrid.TileGrid({
              extent,
              origin: [-half, half],
              minZoom: 0,
              resolutions: Array.from(
                { length: maxZoom + 1 },
                (_, zoom) => (2 * half) / tileSize / 2 ** zoom,
              ),
              tileSize,
            }),
            tileSize,
            url: `https://tile.gbif.org/3031/omt/{z}/{x}/{y}@1x.png?style=${tileStyle}`,
            attributions:
              '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>, © <a href="https://www.openmaptiles.org/copyright">OpenMapTiles</a>, © <a href="https://www.gbif.org/citation-guidelines">GBIF</a>',
          }),
        }),
        new ol.layer.Vector({
          source: vectorSource,
          style: markerStyle,
        }),
      ],
      overlays: [polarOverlay],
      view: new ol.View({
        projection: polarProjection,
        center: [0, 0],
        zoom: 2,
        minZoom: 1,
        maxZoom,
        extent,
        showFullExtent: true,
      }),
    });

    for (const spot of spotMapData) {
      const feature = new ol.Feature({
        geometry: new ol.geom.Point(polarCoordinate(spot.position)),
        rank: spot.rank,
        hidden: false,
      });
      feature.setId(spot.id);
      vectorSource.addFeature(feature);
      markerRecords.push({ spot, feature });
    }

    spotsMap.on("click", (event) => {
      const feature = spotsMap.forEachFeatureAtPixel(event.pixel, (hit) => hit);
      if (!feature || !popupElement || !popupContent) {
        polarOverlay.setPosition(undefined);
        if (popupElement) popupElement.hidden = true;
        return;
      }

      const spot = spotMapData.find((entry) => entry.id === feature.getId());
      if (!spot) return;

      popupContent.innerHTML = popupHtml(spot);
      popupElement.hidden = false;
      polarOverlay.setPosition(feature.getGeometry().getCoordinates());
    });

    spotsMap.on("pointermove", (event) => {
      mapElement.style.cursor = spotsMap.hasFeatureAtPixel(event.pixel) ? "pointer" : "";
    });

    requestAnimationFrame(() => spotsMap.updateSize());
  };

  const initGoogleMap = async () => {
    if (!mapElement || !googleMapsApiKey || !window.google?.maps?.importLibrary) return;

    const { Map, InfoWindow } = await google.maps.importLibrary("maps");
    await google.maps.importLibrary("marker");

    spotsMap = new Map(mapElement, {
      center: mapCenter,
      clickableIcons: false,
      fullscreenControl: true,
      mapTypeControl: false,
      streetViewControl: false,
      zoom: mapZoom,
    });
    infoWindow = new InfoWindow();

    for (const spot of spotMapData) {
      const marker = new google.maps.Marker({
        map: spotsMap,
        position: spot.position,
        title: `${spot.rank}. ${spot.name}`,
        label: String(spot.rank),
      });

      marker.addListener("click", () => {
        infoWindow.setContent(popupHtml(spot));
        infoWindow.open(spotsMap, marker);
      });

      markerRecords.push({ spot, marker });
    }
  };

  const initMap = async () => {
    if (!mapElement) return;

    if (mapEngine === "polar-south") {
      initPolarMap();
    } else {
      await initGoogleMap();
    }

    applyFilters();
  };

  locationFilter?.addEventListener("change", applyFilters);
  kindFilter?.addEventListener("change", applyFilters);
  sortSelect?.addEventListener("change", applyFilters);
  resetFiltersButton?.addEventListener("click", () => {
    if (locationFilter) locationFilter.value = "";
    if (kindFilter) kindFilter.value = "";
    if (sortSelect) sortSelect.value = "score";
    applyFilters();
  });
  window.addEventListener("pageshow", applyFilters);
  initMap().catch((error) => {
    console.error(`Unable to initialize ${mapErrorLabel} spots map`, error);
    if (mapStatus) mapStatus.textContent = "Map unavailable. The list still works.";
  });
</script>

