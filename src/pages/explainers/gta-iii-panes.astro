    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>

    <style is:global>
      :root {
        --bg: #0a0d12;
        --panel: #11151c;
        --line: #212832;
        --ink: #e9edf2;
        --dim: #95a0ad;
        --gold: #f0a13c; /* PS2 HUD chrome */
        --teal: #2fd6c3; /* ground truth  */
        --red: #ff5d5d; /* what the code believes */
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
      }
      body {
        background: var(--bg);
        color: var(--ink);
        font:
          15px/1.6 ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .wrap {
        max-width: 900px;
        margin: 0 auto;
        padding: 22px 14px 70px;
      }

      .home-link {
        display: inline-block;
        margin-bottom: 14px;
        font:
          700 11px/1 ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--dim);
        text-decoration: none;
      }
      .home-link:hover {
        color: var(--gold);
      }

      /* header — PS2 HUD voice */
      .kicker {
        font:
          700 11px/1 ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;
        letter-spacing: 0.22em;
        color: var(--gold);
        text-transform: uppercase;
      }
      h1 {
        margin: 0.25em 0 0;
        font-weight: 900;
        text-transform: uppercase;
        font-size: clamp(27px, 6vw, 44px);
        line-height: 0.98;
        letter-spacing: -0.01em;
        text-shadow: 3px 3px 0 #000;
      }
      h1 em {
        font-style: normal;
        color: var(--gold);
      }
      .lede {
        color: var(--dim);
        margin: 0.7em 0 0;
        max-width: 62ch;
      }
      .lede b {
        color: var(--ink);
      }
      a {
        color: var(--gold);
      }

      /* stage */
      .stage {
        position: relative;
        margin-top: 18px;
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        background: #080a0e;
      }
      canvas {
        display: block;
        width: 100%;
        touch-action: none;
        cursor: crosshair;
      }
      .hud {
        position: absolute;
        top: 10px;
        right: 12px;
        text-align: right;
        pointer-events: none;
        font:
          700 12px/1.7 ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;
        color: var(--gold);
        text-shadow: 2px 2px 0 #000;
        letter-spacing: 0.04em;
      }
      .hud .t {
        color: var(--teal);
      }
      .hud .r {
        color: var(--red);
      }
      .hint {
        position: absolute;
        left: 50%;
        bottom: 12px;
        transform: translateX(-50%);
        font:
          600 12px/1 ui-monospace,
          monospace;
        color: #cdd6df;
        background: rgba(8, 10, 14, 0.72);
        border: 1px solid var(--line);
        padding: 7px 12px;
        border-radius: 999px;
        pointer-events: none;
        transition: opacity 0.4s;
        white-space: nowrap;
      }
      .hint.off {
        opacity: 0;
      }
      .noscript {
        margin: 18px 0 0;
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 12px;
        padding: 14px 16px;
        color: var(--dim);
      }

      /* controls */
      .controls {
        margin-top: 14px;
        display: grid;
        gap: 14px;
      }
      .glabel {
        font:
          700 11px/1 ui-monospace,
          monospace;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--dim);
        display: block;
        margin-bottom: 8px;
      }
      .seg {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
      }
      @media (min-width: 640px) {
        .seg {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .seg button {
        appearance: none;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--ink);
        border-radius: 10px;
        padding: 10px 8px;
        cursor: pointer;
        font:
          700 13px/1.2 inherit;
        text-align: left;
        transition: border-color 0.15s;
      }
      .seg button span {
        display: block;
        font:
          400 11px/1.4 ui-monospace,
          monospace;
        color: var(--dim);
        margin-top: 3px;
        text-transform: none;
        letter-spacing: 0;
      }
      .seg button[aria-pressed="true"] {
        border-color: var(--gold);
        box-shadow: inset 0 0 0 1px var(--gold);
      }
      .seg button:focus-visible,
      button:focus-visible,
      input:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 2px;
      }

      .sliders {
        display: grid;
        gap: 10px;
      }
      @media (min-width: 640px) {
        .sliders {
          grid-template-columns: repeat(3, 1fr);
        }
