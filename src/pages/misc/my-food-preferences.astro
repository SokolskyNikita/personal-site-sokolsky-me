---
export const prerender = true;

const pageTitle = "My food preferences";
const pageDescription =
  "My dietary rules as a picky ovo-lacto vegetarian, plus favorite foods and go-to restaurant orders.";
const themeColorLight = "#ffffff";
const themeColorDark = "#111111";
const siteUrl =
  (Astro.site?.toString() ?? "https://sokolsky.me").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={themeColorLight} />
    <meta name="theme-color" content={themeColorLight} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColorDark} media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="sokolsky.me" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonicalUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <main>
      <p>
        <a href="/">sokolsky.me</a>
        <span class="lang-switch">
          <button type="button" data-set-lang="en" aria-pressed="true">English</button>
          <span aria-hidden="true">|</span>
          <button type="button" data-set-lang="es" aria-pressed="false">Español</button>
        </span>
      </p>

      <div data-lang="en" lang="en">
        <h1>My food preferences</h1>

        <p>I'm an <strong>ovo-lacto vegetarian</strong>, and honey is fine too.</p>

        <p>I can't eat any dish with a <strong>noticeable meat or fish flavor or smell</strong>. Trace or imperceptible amounts of non-vegetarian ingredients, like gelatin, don't bother me.</p>

        <h2>What I don't eat</h2>
        <ul>
          <li><strong>Meat, fish and poultry.</strong></li>
          <li><strong>Meat substitutes:</strong> tofu, Impossible and Beyond products, tempeh, seitan.</li>
          <li><strong>Cooked vegetables</strong> of any kind (boiled, sauteed, roasted), <em>except the ones listed below</em>.</li>
          <li><strong>Mushrooms</strong>, in any form.</li>
        </ul>

        <h2>What I do eat</h2>
        <ul>
          <li><strong>Dairy, eggs, honey and gelatin.</strong></li>
          <li><strong>All grains, breads, pastas and rice.</strong></li>
          <li><strong>All fruit.</strong></li>
          <li><strong>Raw vegetables</strong> of any kind, as long as they're fresh and uncooked.</li>
          <li><strong>Potatoes, tomatoes and corn</strong>, cooked any way at all: boiled, sauteed, roasted, as tomato sauce, as soup.</li>
          <li><strong>Cooked beans and chickpeas</strong>, including hummus and bean burritos.</li>
          <li><strong>Onion and garlic</strong> in small amounts, fried and mixed into a dish. <em>Not as a standalone cooked side.</em></li>
          <li><strong>Pickled and fermented vegetables</strong> like pickles and sauerkraut.</li>
          <li><strong>Seaweed</strong> in small amounts, e.g. nori wraps.</li>
          <li><strong>Fried or wrapped items filled with vegetables</strong>, along the lines of spring rolls and samosas.</li>
        </ul>

        <h2>Favorites</h2>
        <ul>
          <li><strong>Taco Bell</strong> is my go-to fast food: anything vegetarian, especially bean-and-cheese burritos, cheese quesadillas and potato tacos. <em>No fajita vegetables, no sofritas.</em></li>
          <li><strong>Chipotle:</strong> the veggie burrito bowl. <em>Also no fajita vegetables, no sofritas.</em></li>
          <li><strong>Vareniki (pierogi):</strong> potato and cheese fillings, plus sweet cherry ones for dessert. <em>Never mushroom.</em></li>
          <li><strong>Pizza:</strong> cheese and tomato. <em>No cooked-vegetable toppings.</em></li>
          <li><strong>Pasta with tomato sauce:</strong> marinara, pomodoro or cheese ravioli in tomato sauce. <em>No cooked-vegetable add-ins.</em></li>
        </ul>

        <p><em>Liking Taco Bell and Chipotle doesn't mean I like Mexican food, though. I generally avoid "authentic" Mexican cuisine.</em></p>

        <p>Other favorites:</p>
        <ul>
          <li><strong>Tomato soup</strong> with grilled cheese.</li>
          <li><strong>Potatoes:</strong> hash browns, baked potatoes, latkes.</li>
          <li><strong>Hummus</strong> with pita and fresh vegetables.</li>
          <li><strong>Bean-and-cheese burritos or bowls</strong>, made with vegetarian beans and <em>no fajita vegetables</em>.</li>
          <li><strong>Vegetable spring rolls and samosas.</strong></li>
          <li><strong>Vegetable sushi</strong>, cucumber and avocado rolls above all.</li>
          <li><strong>Fried cheese:</strong> Czech smazeny syr, mozzarella sticks, cheese curds.</li>
          <li><strong>Egg-and-cheese dishes:</strong> cheese omelets and breakfast sandwiches, <em>as long as there are no cooked vegetables in them</em>.</li>
        </ul>
      </div>

      <div data-lang="es" lang="es" hidden>
        <h1>Mis preferencias de comida</h1>

        <p>Soy <strong>ovolactovegetariano</strong>, y la miel también está bien.</p>

        <p>No puedo comer ningún plato que tenga un <strong>gusto o un olor perceptible a carne o pescado</strong>. Las trazas o cantidades imperceptibles de ingredientes no vegetarianos, como la gelatina, no me molestan.</p>

        <h2>Qué no como</h2>
        <ul>
          <li><strong>Carne, pescado y aves.</strong></li>
          <li><strong>Sustitutos de la carne:</strong> tofu, productos Impossible y Beyond, tempeh, seitán.</li>
          <li><strong>Verduras cocidas</strong> de cualquier tipo (hervidas, salteadas, al horno), <em>salvo las que están en la lista de abajo</em>.</li>
          <li><strong>Hongos</strong>, en cualquier forma.</li>
        </ul>

        <h2>Qué sí como</h2>
        <ul>
          <li><strong>Lácteos, huevos, miel y gelatina.</strong></li>
          <li><strong>Todos los cereales, panes, pastas y arroz.</strong></li>
          <li><strong>Toda la fruta.</strong></li>
          <li><strong>Verduras crudas</strong> de cualquier tipo, siempre que estén frescas y sin cocinar.</li>
          <li><strong>Papas, tomates y choclo</strong>, cocidos de cualquier manera: hervidos, salteados, al horno, en salsa de tomate, en sopa.</li>
          <li><strong>Porotos y garbanzos cocidos</strong>, incluidos el hummus y los burritos de porotos.</li>
          <li><strong>Cebolla y ajo</strong> en poca cantidad, fritos y mezclados dentro del plato. <em>No como guarnición cocida aparte.</em></li>
          <li><strong>Verduras en vinagre o fermentadas</strong>, como los pickles y el chucrut.</li>
          <li><strong>Algas</strong> en poca cantidad, por ejemplo en rolls con nori.</li>
          <li><strong>Frituras o envueltos rellenos de verdura</strong>, tipo arrolladitos primavera y samosas.</li>
        </ul>

        <h2>Favoritos</h2>
        <ul>
          <li><strong>Taco Bell</strong> es mi comida rápida preferida: cualquier opción vegetariana, sobre todo los burritos de porotos y queso, las quesadillas de queso y los tacos de papa. <em>Sin las verduras de fajita y sin sofritas.</em></li>
          <li><strong>Chipotle:</strong> el bowl de burrito vegetariano. <em>También sin las verduras de fajita y sin sofritas.</em></li>
          <li><strong>Varenikes (pierogis):</strong> rellenos de papa y de queso, más los de cereza dulce de postre. <em>Nunca de hongos.</em></li>
          <li><strong>Pizza:</strong> de queso y tomate. <em>Sin verduras cocidas encima.</em></li>
          <li><strong>Pastas con salsa de tomate:</strong> marinara, pomodoro o ravioles de queso con salsa de tomate. <em>Sin verduras cocidas agregadas.</em></li>
        </ul>

        <p><em>Que me gusten Taco Bell y Chipotle no quiere decir que me guste la comida mexicana: en general evito la cocina mexicana "auténtica".</em></p>

        <p>Otros favoritos:</p>
        <ul>
          <li><strong>Sopa de tomate</strong> con tostado de queso.</li>
          <li><strong>Papas:</strong> hash browns, papas al horno, latkes.</li>
          <li><strong>Hummus</strong> con pan pita y verduras frescas.</li>
          <li><strong>Burritos o bowls de porotos y queso</strong>, hechos con porotos vegetarianos y <em>sin las verduras de fajita</em>.</li>
          <li><strong>Arrolladitos primavera y samosas de verdura.</strong></li>
          <li><strong>Sushi de verduras</strong>, ante todo los rolls de pepino y de palta.</li>
          <li><strong>Queso frito:</strong> el smazeny syr checo, los bastones de muzzarella, los cheese curds.</li>
          <li><strong>Platos de huevo y queso:</strong> omelettes de queso y sándwiches de desayuno, <em>siempre que no tengan verduras cocidas</em>.</li>
        </ul>
      </div>
    </main>

    <script>
      const titles: Record<string, string> = {
        en: "My food preferences",
        es: "Mis preferencias de comida",
      };
      const buttons = document.querySelectorAll<HTMLButtonElement>("button[data-set-lang]");
      const sections = document.querySelectorAll<HTMLElement>("main div[data-lang]");

      function setLang(lang: string) {
        sections.forEach((section) => {
          section.hidden = section.dataset.lang !== lang;
        });
        buttons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.setLang === lang));
        });
        document.documentElement.lang = lang;
        document.title = titles[lang] ?? titles.en;
        try {
          localStorage.setItem("food-prefs-lang", lang);
        } catch {
          /* private mode etc. */
        }
      }

      buttons.forEach((button) => {
        button.addEventListener("click", () => setLang(button.dataset.setLang ?? "en"));
      });

      let saved: string | null = null;
      try {
        saved = localStorage.getItem("food-prefs-lang");
      } catch {
        /* ignore */
      }
      if (saved === "es") setLang("es");
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --text: #111111;
    --muted: #555555;
    --link: #111111;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111111;
      --text: #eeeeee;
      --muted: #aaaaaa;
      --link: #eeeeee;
    }
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.55;
  }

  body {
    margin: 0;
    padding: 1.25rem;
  }

  main {
    max-width: 44rem;
  }

  h1 {
    margin: 1.25rem 0;
    font-size: 1.7rem;
    line-height: 1.15;
  }

  h2 {
    margin: 1.4rem 0 0.6rem;
    font-size: 1.2rem;
    line-height: 1.2;
  }

  p,
  ul {
    margin: 0 0 0.9rem;
  }

  ul {
    padding-left: 1.25rem;
  }

  li {
    margin: 0.2rem 0;
  }

  a {
    color: var(--link);
  }

  body > main > p:first-child {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .lang-switch button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .lang-switch button[aria-pressed="true"] {
    text-decoration: none;
    font-weight: 600;
    cursor: default;
  }
</style>
