---
export const prerender = true;

const pageTitle = "5-day trip from Buenos Aires, September 2026";
const pageDescription =
  "Top South America destinations that fit a 5-day trip from EZE/AEP in September 2026, ranked by door-to-hotel time. Two adults, economy round-trip, 3-star+ hotel by US standards.";
const themeColorLight = "#f7f4ef";
const themeColorDark = "#161412";
const siteUrl = (Astro.site?.toString() ?? "https://sokolsky.me").replace(
  /\/$/,
  "",
);
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const usd = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});

type Pick = {
  rank: number;
  place: string;
  airport: string;
  wiki: string;
  via: "nonstop" | "1-stop";
  flightTime: string;
  time: string;
  timeMinutes: number;
  window: string;
  flightCost: number;
  hotelCost: number;
  rain: string;
  day: string;
  what: string;
};

const picks: Pick[] = [
  {
    rank: 1,
    place: "Iguazú Falls",
    airport: "IGR",
    wiki: "https://en.wikipedia.org/wiki/Iguazu_Falls",
    via: "nonstop",
    flightTime: "1h 55m",
    time: "4h 50m",
    timeMinutes: 290,
    window: "Wed 9 → Mon 14",
    flightCost: 464,
    hotelCost: 490,
    rain: "33%",
    day: "27°C",
    what: "A horseshoe of the Iguazú River breaks into hundreds of cascades on a basaltic rim, with Atlantic Forest around it.",
  },
  {
    rank: 2,
    place: "Península Valdés",
    airport: "REL",
    wiki: "https://en.wikipedia.org/wiki/Valdes_Peninsula",
    via: "nonstop",
    flightTime: "2h 05m",
    time: "5h 25m",
    timeMinutes: 325,
    window: "Wed 9 → Mon 14",
    flightCost: 661,
    hotelCost: 407,
    rain: "8%",
    day: "17°C",
    what: "An arid Patagonian peninsula where southern right whales calve in the gulfs and orcas, seals, and penguins use the coast.",
  },
  {
    rank: 3,
    place: "Perito Moreno",
    airport: "FTE",
    wiki: "https://en.wikipedia.org/wiki/Perito_Moreno_Glacier",
    via: "nonstop",
    flightTime: "3h 20m",
    time: "6h 15m",
    timeMinutes: 375,
    window: "Wed 9 → Mon 14",
    flightCost: 837,
    hotelCost: 181,
    rain: "11%",
    day: "9°C",
    what: "A large outlet glacier you can watch calve into a lake, the accessible edge of the Southern Patagonian Ice Field.",
  },
  {
    rank: 4,
    place: "Caral-Supe",
    airport: "LIM",
    wiki: "https://en.wikipedia.org/wiki/Caral",
    via: "nonstop",
    flightTime: "4h 45m",
    time: "9h 25m",
    timeMinutes: 565,
    window: "Wed 9 → Mon 14",
    flightCost: 657,
    hotelCost: 542,
    rain: "1%",
    day: "26°C",
    what: "Monumental earthen mounds and sunken courts from a planned city about 5,000 years old, long before the Inca.",
  },
  {
    rank: 5,
    place: "Humberstone",
    airport: "IQQ",
    wiki: "https://en.wikipedia.org/wiki/Humberstone_and_Santa_Laura_Saltpeter_Works",
    via: "1-stop",
    flightTime: "6h 48m",
    time: "10h 53m",
    timeMinutes: 653,
    window: "Wed 9 → Mon 14",
    flightCost: 662,
    hotelCost: 336,
    rain: "0%",
    day: "19°C",
    what: "Abandoned nitrate company towns in the Atacama, left standing after synthetic fertilizer killed the business.",
  },
  {
    rank: 6,
    place: "Moray and Maras",
    airport: "CUZ",
    wiki: "https://en.wikipedia.org/wiki/Moray_(Inca_ruin)",
    via: "1-stop",
    flightTime: "8h 00m",
    time: "12h 40m",
    timeMinutes: 760,
    window: "Wed 9 → Mon 14",
    flightCost: 892,
    hotelCost: 963,
    rain: "6%",
    day: "18°C",
    what: "Concentric Inca terraces with a large temperature gradient, next to working salt wells still run by local families.",
  },
  {
    rank: 7,
    place: "Colca Canyon",
    airport: "AQP",
    wiki: "https://en.wikipedia.org/wiki/Colca_Canyon",
    via: "1-stop",
    flightTime: "8h 05m",
    time: "12h 45m",
    timeMinutes: 765,
    window: "Wed 9 → Mon 14",
    flightCost: 867,
    hotelCost: 759,
    rain: "5%",
    day: "21°C",
    what: "A deep inhabited Andean canyon with pre-Inca terraces and morning condors riding thermals at eye level.",
  },
  {
    rank: 8,
    place: "Tiwanaku",
    airport: "LPB",
    wiki: "https://en.wikipedia.org/wiki/Tiwanaku",
    via: "1-stop",
    flightTime: "8h 15m",
    time: "13h 05m",
    timeMinutes: 785,
    window: "Wed 9 → Mon 14",
    flightCost: 1130,
    hotelCost: 826,
    rain: "10%",
    day: "14°C",
    what: "Pre-Inca stonework and ritual architecture on the Titicaca altiplano, from a state that flourished long before Cusco.",
  },
  {
    rank: 9,
    place: "Chan Chan",
    airport: "TRU",
    wiki: "https://en.wikipedia.org/wiki/Chan_Chan",
    via: "1-stop",
    flightTime: "10h 00m",
    time: "14h 05m",
    timeMinutes: 845,
    window: "Wed 9 → Mon 14",
    flightCost: 840,
    hotelCost: 293,
    rain: "1%",
    day: "21°C",
    what: "The Chimú capital on Peru’s desert coast: adobe palaces, walled compounds, and reliefs unlike Inca stone.",
  },
  {
    rank: 10,
    place: "Meeting of Waters",
    airport: "MAO",
    wiki: "https://en.wikipedia.org/wiki/Meeting_of_Waters",
    via: "1-stop",
    flightTime: "6h 55m",
    time: "14h 15m",
    timeMinutes: 855,
    window: "Wed 9 → Mon 14",
    flightCost: 1559,
    hotelCost: 293,
    rain: "33%",
    day: "33°C",
    what: "The dark Negro and muddy Solimões run side by side for kilometres before mixing into the Amazon.",
  },
];

const ruledOut = [
  {
    place: "Kaieteur Falls",
    reason:
      "Highest score on the South America list, but the Georgetown day-flight plus weather buffer is a 6-day trip.",
  },
  {
    place: "Mount Roraima",
    reason: "The standard trek is 6–7 walking days before flights and transfers.",
  },
  {
    place: "Torres del Paine",
    reason: "A real visit is about 8 days once you add Punta Arenas or El Calafate access.",
  },
  {
    place: "Galápagos Islands",
    reason: "Mainland connection plus island time is about 9 days.",
  },
  {
    place: "Pantanal",
    reason: "Lodge packages from Cuiabá or Campo Grande are about 7 days.",
  },
  {
    place: "Salar de Uyuni and Sud Lípez",
    reason: "The 3-day salt-flat circuit plus La Paz or Santa Cruz connections is about 7 days.",
  },
  {
    place: "Tierra del Fuego / Ushuaia",
    reason: "Fits five days, but skipped on this page. Next 5-day pick is Caral-Supe.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  numberOfItems: picks.length,
  itemListElement: picks.map((pick) => ({
    "@type": "ListItem",
    position: pick.rank,
    name: `${pick.place} (${pick.airport})`,
    description: `${pick.flightTime} flight, ${pick.time} door to hotel. ${usd.format(pick.flightCost + pick.hotelCost)} for two.`,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content={themeColorLight} />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="sokolsky.me" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}
    ></script>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <a class="home" href="/">sokolsky.me</a>
        <p class="eyebrow">September 2026 · 5 days · two people</p>
        <h1>Five-day trips from Buenos Aires</h1>
        <p class="lede">
          Highest-scoring places from the
          <a href="/travel/best-of-south-america/">South America list</a>
          that actually fit five days. Default rank is door-to-hotel time from
          Palermo (taxi to AEP or EZE, check-in, flight, immigration,
          transfer). Toggle to sort by flights plus hotel. Costs are two
          economy round-trips plus five nights in a US 3-star+ hotel. Window is
          9–14 Sep 2026. Checked 24 Aug 2026.
        </p>
        <fieldset class="sort">
          <legend>Sort</legend>
          <div class="sort-options">
            <input
              id="sort-time"
              type="radio"
              name="sort"
              value="time"
              checked
            />
            <label for="sort-time">Door-to-door</label>
            <input id="sort-price" type="radio" name="sort" value="price" />
            <label for="sort-price">Price</label>
          </div>
        </fieldset>
      </header>

      <ol class="picks" id="picks">
        {
          picks.map((pick) => (
            <li
              class="pick"
              data-time={pick.timeMinutes}
              data-price={pick.flightCost + pick.hotelCost}
            >
              <div class="pick-top">
                <span class="rank" aria-hidden="true">
                  {pick.rank}
                </span>
                <div class="pick-title">
                  <h2>
                    <a
                      class="place"
                      href={pick.wiki}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {pick.place}
                    </a>
                    <span class="iata">{pick.airport}</span>
                  </h2>
                  <p class="meta">
                    {pick.time} door to hotel · {pick.via} · {pick.flightTime}{" "}
                    airborne
                  </p>
                </div>
                <p class="total">
                  <strong>{usd.format(pick.flightCost + pick.hotelCost)}</strong>
                  <span>flights + hotel</span>
                </p>
              </div>
              <dl class="facts">
                <div>
                  <dt>Window</dt>
                  <dd>{pick.window}</dd>
                </div>
                <div>
                  <dt>Flight</dt>
                  <dd>{pick.flightTime}</dd>
                </div>
                <div>
                  <dt>2× RT</dt>
                  <dd>{usd.format(pick.flightCost)}</dd>
                </div>
                <div>
                  <dt>Hotel 5n</dt>
                  <dd>{usd.format(pick.hotelCost)}</dd>
                </div>
                <div>
                  <dt>Rain</dt>
                  <dd>{pick.rain}</dd>
                </div>
                <div>
                  <dt>Day</dt>
                  <dd>{pick.day}</dd>
                </div>
              </dl>
              <p class="detail">{pick.what}</p>
            </li>
          ))
        }
      </ol>

      <section class="ruled" aria-labelledby="ruled-heading">
        <h2 id="ruled-heading">Close, but out</h2>
        <ul>
          {
            ruledOut.map((item) => (
              <li>
                <strong>{item.place}.</strong> {item.reason}
              </li>
            ))
          }
        </ul>
      </section>

      <footer class="footer">
        <p>
          Flights: Google Flights via SearchAPI, two adults, economy, gl=AR,
          EZE/AEP, 9–14 Sep 2026. Hotels: Google Hotels, two adults, same dates,
          US 3-star+ (Ibis, Holiday Inn Express, Hilton Garden Inn, Wyndham,
          Costa del Sol, Casa Grande). Door-to-door from Palermo: AEP taxi ~45
          min or EZE ~70 min, domestic check-in 90 min, international 120 min,
          plus immigration, bags, and the local transfer. Sea-level and altitude
          buffers are not in the clock. Rain and day are
          <a href="https://weatherspark.com/">Weather Spark</a>
          September climate: chance of a wet day (≥1&nbsp;mm) and daily high
          around 9–14 Sep, at the site (Puerto Supe for Caral, Colca for the
          canyon).
        </p>
      </footer>
    </main>
    <script>
      const list = document.getElementById("picks");
      if (list) {
        const items = [...list.querySelectorAll<HTMLElement>(".pick")];
        const applySort = (key: "time" | "price") => {
          items
            .slice()
            .sort(
              (left, right) =>
                Number(left.dataset[key]) - Number(right.dataset[key]),
            )
            .forEach((item, index) => {
              const rank = item.querySelector(".rank");
              if (rank) rank.textContent = String(index + 1);
              list.append(item);
            });
        };
        for (const input of document.querySelectorAll<HTMLInputElement>(
          'input[name="sort"]',
        )) {
          input.addEventListener("change", () => {
            if (input.checked && (input.value === "time" || input.value === "price")) {
              applySort(input.value);
            }
          });
        }
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --bg: #f7f4ef;
    --ink: #1c1914;
    --muted: #5e584e;
    --line: #d5cfc4;
    --soft: #efe9df;
    --accent: #2f5d4a;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161412;
      --ink: #f3eee6;
      --muted: #b3aa9c;
      --line: #3a352d;
      --soft: #221e19;
      --accent: #8fbea8;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--ink);
    font-family:
      "Iowan Old Style",
      "Palatino Linotype",
      Palatino,
      Georgia,
      serif;
    line-height: 1.45;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
  }

  a {
    color: inherit;
  }

  .page {
    width: min(42rem, 100%);
    margin: 0 auto;
    padding: 1.1rem 1rem 2.4rem;
  }

  .header {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1.4rem;
  }

  .home {
    width: fit-content;
    color: var(--muted);
    font-family:
      "Segoe UI",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-size: 0.82rem;
    text-decoration: none;
  }

  .home:hover {
    text-decoration: underline;
  }

  .eyebrow {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-family:
      "Segoe UI",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2.05rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .lede {
    margin: 0.15rem 0 0;
    max-width: 38rem;
    color: var(--muted);
    font-family:
      "Segoe UI",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-size: 0.95rem;
  }

  .lede a {
    text-underline-offset: 0.12em;
  }

  .sort {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.7rem;
    margin: 0.75rem 0 0;
    padding: 0;
    border: 0;
    font-family:
      "Segoe UI",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
  }

  .sort legend {
    float: left;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.9;
    text-transform: uppercase;
  }

  .sort-options {
    display: flex;
    width: fit-content;
    padding: 0.16rem;
    border: 1px solid var(--line);
    background: var(--soft);
  }

  .sort-options input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .sort-options label {
    min-height: 1.7rem;
    padding: 0.2rem 0.7rem;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .sort-options input:checked + label {
    background: var(--bg);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .sort-options input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .picks {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .pick {
    min-width: 0;
    padding: 0.85rem 0 0.95rem;
    border-top: 1px solid var(--line);
  }

  .pick-top {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr) auto;
    gap: 0.55rem 0.7rem;
    align-items: start;
  }

  .rank {
    color: var(--accent);
    font-family:
      "Segoe UI",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-size: 1.15rem;
    font-weight: 750;
    line-height: 1.2;
  }

  .pick-title {
    min-width: 0;
  }

  h2 {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .place {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }

  .iata {
    margin-left: 0.35rem;
    color: var(--muted);
    font-family:
      "Segoe UI",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .meta,
  .detail,
  .facts,
  .ruled,
  .footer {
    font-family:
      "Segoe UI",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
  }

  .meta {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .total {
    display: grid;
    justify-items: end;
    margin: 0;
    text-align: right;
    white-space: nowrap;
  }

  .total strong {
    font-size: 1.02rem;
    font-variant-numeric: tabular-nums;
  }

  .total span {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem 0.7rem;
    margin: 0.7rem 0 0.45rem;
  }

  .facts dt {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0.12rem 0 0;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .detail {
    margin: 0.28rem 0 0;
    color: var(--muted);
    font-size: 0.86rem;
    overflow-wrap: anywhere;
  }

  .ruled {
    margin-top: 1.5rem;
  }

  .ruled h2 {
    margin: 0 0 0.45rem;
    font-family:
      "Iowan Old Style",
      "Palatino Linotype",
      Palatino,
      Georgia,
      serif;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .ruled ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .ruled li + li {
    margin-top: 0.4rem;
  }

  .footer {
    margin-top: 1.6rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .footer p {
    margin: 0;
  }

  @media (max-width: 640px) {
    .page {
      padding: 0.9rem 0.85rem 2rem;
    }

    .pick-top {
      grid-template-columns: 1.4rem minmax(0, 1fr);
    }

    .total {
      grid-column: 2;
      justify-items: start;
      text-align: left;
    }

    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
