const priceOrder = new Map(
  [...picks]
    .sort((left, right) => {
      const cost =
        left.flightCost +
        left.hotelCost -
        (right.flightCost + right.hotelCost);
      return cost || left.rank - right.rank;
    })
    .map((pick, index) => [pick.airport, index + 1]),
);

const ruledOut = [
  {
    place: "Fernando de Noronha",
    reason: "1-stop out fits, but no return stays under 13h.",
  },
  {
    place: "Aracaju",
    reason: "No nonstop, and September sea averages 25.9°C.",
  },
  {
    place: "Rio / Florianópolis",
    reason: "Daily nonstops, but September sea is 21.3°C and ~19°C.",
  },
];

const airports = [
  ["BPS Porto Seguro", "Wed/Sat/Sun out, Wed/Sat in", "24.5°C", "#1"],
  ["SSA Salvador", "Wed/Thu/Sat/Sun out, Wed/Fri/Sun in", "25.7°C", "#2"],
  ["FOR Fortaleza", "Tue/Sun out, Mon/Wed in", "26.6°C", "#3"],
  ["REC Recife", "Nonstop; no Mon/Thu", "26.4°C", "#4"],
  ["NAT Natal", "No Sat out; Sat in exists", "26.5°C", "#5"],
  ["SLZ São Luís", "1-stop", "27.2°C", "#6"],
  ["MCZ Maceió", "1-stop", "26.2°C", "#7"],
  ["JPA João Pessoa", "1-stop", "26.4°C", "#8"],
  ["JJD Jericoacoara", "1-stop", "26.8°C", "#10"],
  ["FEN Noronha", "1-stop out", "26.5°C", "No return ≤13h"],
  ["AJU Aracaju", "None", "25.9°C", "Water + no nonstop"],
  ["GIG Rio", "Daily", "21.3°C", "Water"],
  ["FLN Florianópolis", "Daily", "~19°C", "Water"],
  ["IOS Ilhéus", "None", "colder than SSA", "No nonstop"],
  ["UNA Una / Comandatuba", "None", "colder than SSA", "No nonstop"],
  ["PHB Parnaíba", "None", "warm", "No nonstop"],
  ["BEL Belém", "None", "far beaches", "No nonstop"],
  ["VIX Vitória", "None", "~23°C", "No nonstop"],
  ["CFB Cabo Frio", "None", "~21°C", "No nonstop"],
  ["NVT Navegantes", "None", "cold", "No nonstop"],
  ["SDU Rio downtown", "None", "21.3°C", "No nonstop"],
] as const;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  numberOfItems: picks.length,
  itemListElement: picks.map((pick) => ({
    "@type": "ListItem",
    position: pick.rank,
    name: `${pick.place} (${pick.airport})`,
    description: `${pick.via}, ${pick.flightTime} flight, ${pick.time} door to hotel. ${pick.water}. ${usd.format(pick.flightCost + pick.hotelCost)} for two.`,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content={themeColorLight} />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="sokolsky.me" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}
    ></script>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <a class="home" href="/">sokolsky.me</a>
        <p class="eyebrow">First or second weekend of September · 4–5 days</p>
        <h1>Warm beach from Buenos Aires</h1>
        <p class="lede">
          Nonstop from EZE/AEP when it exists (sea 23°C+), even if door-to-door
          is over 13 hours. One-stop only if there is no usable nonstop, sea is
          26°C+, and door-to-door is 13 hours or less. Default sort is time from
          Palermo to the hotel; switch to price for cheapest first. Costs are
          two economy round-trips plus five nights in a Marriott-tier hotel
          within a mile of the beach. Checked 24 Aug 2026.
        </p>
      </header>

      <fieldset class="sort-toggle">
        <legend>Sort</legend>
        <input
          id="sort-time"
          type="radio"
          name="sort"
          value="time"
          autocomplete="off"
          checked
        />
        <label for="sort-time">Door to hotel</label>
        <input
          id="sort-price"
          type="radio"
          name="sort"
          value="price"
          autocomplete="off"
        />
        <label for="sort-price">Price</label>
      </fieldset>

      <ol class="picks" id="picks">
        {
          picks.map((pick) => (
            <li
              class="pick"
              style={`--sort-time: ${pick.rank}; --sort-price: ${priceOrder.get(pick.airport)}`}
              data-sort-time={pick.rank}
              data-sort-price={priceOrder.get(pick.airport)}
            >
              <div class="pick-top">
                <span class="rank" aria-hidden="true">
                  {pick.rank}
                </span>
                <div class="pick-title">
                  <h2>
                    {pick.place}
                    <span class="iata">{pick.airport}</span>
                  </h2>
                  <p class="meta">
                    {pick.time} door to hotel · {pick.via} · {pick.diving}
                  </p>
                </div>
                <p class="total">
                  <strong>{usd.format(pick.flightCost + pick.hotelCost)}</strong>
                  <span>flights + hotel</span>
                </p>
              </div>
              <dl class="facts">
                <div>
                  <dt>Window</dt>
                  <dd>{pick.window}</dd>
                </div>
                <div>
                  <dt>Flight</dt>
                  <dd>{pick.flightTime}</dd>
                </div>
                <div>
                  <dt>2× RT</dt>
                  <dd>{usd.format(pick.flightCost)}</dd>
                </div>
                <div>
                  <dt>Hotel 5n</dt>
                  <dd>{usd.format(pick.hotelCost)}</dd>
                </div>
              </dl>
              <dl class="facts climate">
                <div>
                  <dt>Sea</dt>
                  <dd>{pick.water}</dd>
                </div>
                <div>
                  <dt>Day high</dt>
                  <dd>{pick.day}</dd>
                </div>
                <div>
                  <dt>Rain</dt>
                  <dd>{pick.rain}%</dd>
                </div>
              </dl>
                    <table class="week">
                      <caption>
                        {pick.via === "nonstop" ? "Nonstop" : "1-stop ≤13h"}
                      </caption>
                      <thead>
                        <tr>
                          <th scope="col">
                            <span class="visually-hidden">Direction</span>
                          </th>
                          {weekDays.map((day) => (
                            <th scope="col">{day}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <th scope="row">Out</th>
                          {pick.outbound.map((count) => (
                            <td class={count === 0 ? "empty" : undefined}>
                              {cell(count)}
                            </td>
                          ))}
                        </tr>
                        <tr>
                          <th scope="row">In</th>
                          {pick.inbound.map((count) => (
                            <td class={count === 0 ? "empty" : undefined}>
                              {cell(count)}
                            </td>
                          ))}
                        </tr>
                      </tbody>
                    </table>
            </li>
          ))
        }
      </ol>

      <section class="ruled" aria-labelledby="ruled-heading">
        <h2 id="ruled-heading">Close, but out</h2>
        <ul>
          {
            ruledOut.map((item) => (
              <li>
                <strong>{item.place}.</strong> {item.reason}
              </li>
            ))
          }
        </ul>
      </section>

      <details class="audit">
        <summary>Brazilian beach-airport audit (21)</summary>
        <p>
          Coastal airports that can take international traffic, checked for
          EZE/AEP nonstops and 1-stops under 13h on 1–16 Sep.
        </p>
        <ul class="audit-list">
          {
            airports.map(([airport, nonstop, water, status]) => (
              <li>
                <strong>{airport}</strong>
                <span>
                  {nonstop} · {water} · {status}
                </span>
              </li>
            ))
          }
        </ul>
      </details>

      <footer class="footer">
        <p>
          Flights: Google Flights, two adults, economy, gl=AR. If a nonstop
          exists, only nonstops are shown, including trips over 13 hours.
          One-stop counts are only for airports with no usable nonstop, and
          stay ≤13h. Weekday tables cover the week of 1–8 Sep.           Hotels: Google
          Hotels, two adults, ~4–9 Sep. Sea: seatemperature.org monthly
          averages. Day high and rain: Weatherspark typical September daily
          high and chance of a wet day (≥1 mm); rain is the mid-month value
          when the month slides. Jericoacoara air is Cruz, the nearest
          Weatherspark station. US Marriott Hotels ADR $211, Courtyard $164
          (Q3 2025, US &amp; Canada).
        </p>
      </footer>
    </main>
    <script>
      const list = document.querySelector("#picks");
      const radios = document.querySelectorAll<HTMLInputElement>(
        'input[name="sort"]',
      );
      const items = list
        ? [...list.querySelectorAll<HTMLElement>(".pick")]
        : [];

      const applySort = () => {
        if (!list) return;
        const price = document.querySelector<HTMLInputElement>("#sort-price");
        const key = price?.checked ? "sortPrice" : "sortTime";
        items
          .sort(
            (left, right) =>
              Number(left.dataset[key]) - Number(right.dataset[key]),
          )
          .forEach((item, index) => {
            const rank = item.querySelector(".rank");
            if (rank) rank.textContent = String(index + 1);
            list.append(item);
          });
      };

      for (const radio of radios) {
        radio.addEventListener("change", applySort);
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --bg: #f7f4ef;
    --ink: #1c1914;
    --muted: #5e584e;
    --line: #d5cfc4;
    --soft: #efe9df;
    --accent: #2f5d4a;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161412;
      --ink: #f3eee6;
      --muted: #b3aa9c;
      --line: #3a352d;
      --soft: #221e19;
      --accent: #8fbea8;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--ink);
    font-family:
      "Iowan Old Style",
      "Palatino Linotype",
      Palatino,
      Georgia,
      serif;
    line-height: 1.45;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
  }

  a {
    color: inherit;
  }

  .page {
    width: min(42rem, 100%);
    margin: 0 auto;
    padding: 1.1rem 1rem 2.4rem;
  }

  .header {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1.4rem;
  }

  .home {
    width: fit-content;
    color: var(--muted);
    font-family:
      "Segoe UI",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-size: 0.82rem;
    text-decoration: none;
  }

  .home:hover {
    text-decoration: underline;
  }

  .eyebrow {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-family:
      "Segoe UI",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2.05rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .lede {
    margin: 0.15rem 0 0;
    max-width: 38rem;
    color: var(--muted);
    font-family:
      "Segoe UI",
