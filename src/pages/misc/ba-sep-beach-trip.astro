---
export const prerender = true;

const pageTitle = "Warm-water beach from Buenos Aires, September 2026";
const pageDescription =
  "Beach options from EZE/AEP for a 4–5 day trip on the first or second weekend of September 2026, ranked by door-to-hotel time. Nonstop when it exists, even if over 13 hours; one-stop only if there is no nonstop and door-to-door is 13 hours or less.";
const themeColorLight = "#f7f4ef";
const themeColorDark = "#161412";
const siteUrl = (Astro.site?.toString() ?? "https://sokolsky.me").replace(
  /\/$/,
  "",
);
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const usd = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});

const weekDays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] as const;
type WeekCounts = [number, number, number, number, number, number, number];

type Pick = {
  rank: number;
  place: string;
  airport: string;
  via: "nonstop" | "1-stop";
  flightTime: string;
  time: string;
  water: string;
  day: string;
  rain: number;
  diving: string;
  window: string;
  flights: string;
  flightCost: number;
  hotel: string;
  hotelCost: number;
  note: string;
  outbound: WeekCounts;
  inbound: WeekCounts;
};

const cell = (count: number) => (count > 0 ? String(count) : "-");

const picks: Pick[] = [
  {
    rank: 1,
    place: "Porto Seguro",
