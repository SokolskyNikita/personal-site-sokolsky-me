<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={themeColorLight} />
    <meta name="theme-color" content={themeColorLight} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColorDark} media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    <main>
      <p><a href="/">sokolsky.me</a></p>

      <h1>{pageTitle}</h1>

      <p class="count">Total skincare items: {totalSkincareItems}</p>

      <p>
        A practical Buenos Aires/Argentina shopping list. Product names are kept close to the original notes, with the exact version to buy, ingredients, and direct links where I could verify them.
      </p>

      <p class="small">
        Ingredient lists can change by batch and country. For anything prescription-like, compounded, or clinic-dispensed, the package label should win over this page.
      </p>

      {sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <ul class="products">
            {section.items.map((item) => (
              <li>
                <p><strong>{item.name}</strong></p>
                <p>{item.descriptor}</p>

                {item.buy.length > 0 && (
                  <>
                    <p><strong>Buy:</strong></p>
                    <ul class="links">
                      {item.buy.map((link) => (
                        <li>
                          <a href={link.url} target="_blank" rel="noreferrer noopener">
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                <details class="ingredients">
                  <summary>Expand</summary>
                  <p><strong>Ingredients:</strong> {item.ingredients}</p>
                  {"ingredientsNote" in item && <p class="small">{item.ingredientsNote}</p>}
                </details>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --text: #111111;
    --muted: #555555;
    --link: #111111;
    --border: #dddddd;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111111;
      --text: #eeeeee;
      --muted: #aaaaaa;
      --link: #eeeeee;
      --border: #333333;
    }
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.55;
  }

  body {
    margin: 0;
    padding: 1.25rem;
  }

  main {
    max-width: 50rem;
  }

  h1 {
    margin: 1.25rem 0 0.8rem;
    font-size: 1.7rem;
    line-height: 1.15;
  }

  h2 {
    margin: 2rem 0 0.7rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 1.155rem;
    line-height: 1.2;
  }

  p,
  ul {
    margin: 0 0 0.9rem;
  }

  ul {
    padding-left: 1.25rem;
  }

  li {
    margin: 0.2rem 0;
  }

  .products {
    padding-left: 0;
    list-style: none;
  }

  .products > li {
    margin: 0 0 1.35rem;
    padding-left: 1rem;
    border-left: 2px solid var(--border);
  }

  .products > li > p {
    margin-bottom: 0.45rem;
  }

  .links {
    margin-bottom: 0.55rem;
  }

  .small {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .count {
    color: var(--muted);
    font-size: 0.95rem;
  }

  a {
    color: var(--link);
  }

  body > main > p:first-child {
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Responsive editorial pass */
  :root {
    --bg: #fcfaf7;
    --surface: #fffdf8;
    --text: #1e211c;
    --muted: #64685f;
    --link: #234b35;
    --border: #d8d4c9;
    --accent: #2f7350;
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-size: 16px;
    line-height: 1.55;
  }

  body {
    padding: clamp(0.85rem, 2.4vw, 2rem);
    background:
      radial-gradient(circle at 8% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 30rem),
      var(--bg);
  }

  main {
    width: min(100%, 76rem);
    max-width: none;
    margin-inline: auto;
  }

  body > main > p:first-child {
    margin-bottom: clamp(1.1rem, 2.5vw, 2rem);
    font-size: 0.88rem;
  }

  h1 {
    margin: 0 0 0.7rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.15rem, 5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  main > p:not(:first-child) {
    max-width: 60rem;
  }

  .count {
    margin-bottom: 0.7rem;
    font-size: 0.98rem;
  }

  .small {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  section {
    margin-top: clamp(2.2rem, 5vw, 4rem);
  }

  h2 {
    margin: 0 0 1rem;
    padding-top: 0.9rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 2.3vw, 1.9rem);
    letter-spacing: -0.025em;
  }

  .products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.2rem;
  }

  .products > li {
    margin: 0;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    border-left: 0;
  }

  .products > li > p {
    margin-bottom: 0.6rem;
  }

  .products > li > p:first-child {
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-left: 0;
    list-style: none;
  }

  .links li {
    margin: 0;
  }

  .links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .ingredients {
    margin: 0;
  }

  .ingredients summary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 700;
    list-style: none;
    width: fit-content;
  }

  .ingredients summary::-webkit-details-marker {
    display: none;
  }

  .ingredients[open] summary {
    margin-bottom: 0.6rem;
  }

  a {
    color: var(--link);
    text-underline-offset: 0.18em;
  }

  a:focus-visible,
  .ingredients summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 50rem) {
    body {
      padding: 0.75rem;
    }

    .products {
      grid-template-columns: 1fr;
    }

    .products > li {
      padding: 1rem 0 1.2rem;
    }
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151714;
      --surface: #1d201c;
      --text: #f0eee7;
      --muted: #b4b6ad;
      --link: #a7d4b7;
      --border: #3b4038;
      --accent: #76c894;
    }
  }
</style>
