---
export const prerender = true;

import { extractTravelSpotsFromSource } from "../../data/travelRawParser";
import { europeSubregionImportedSpotCounts } from "../../data/europeSubregions";

const pageSources = import.meta.glob<string>("./best-of-*.astro", {
  eager: true,
  query: "?raw",
  import: "default",
});

const continentOrder = [
  "World",
  "Africa",
  "Asia",
  "Europe",
  "North America",
  "South America",
  "Oceania",
  "Polar",
] as const;

type Continent = (typeof continentOrder)[number];

const continentBySlug: Record<string, Continent> = {
  world: "World",
  "central-africa": "Africa",
  "east-africa": "Africa",
  "north-africa": "Africa",
  "southern-africa": "Africa",
  "west-africa": "Africa",
  "central-asia": "Asia",
  "east-asia": "Asia",
  "north-asia": "Asia",
  "south-asia": "Asia",
  "southeast-asia": "Asia",
  "middle-east": "Asia",
  "northern-europe": "Europe",
  "western-europe": "Europe",
  "central-europe": "Europe",
  "southern-europe": "Europe",
  "southeast-europe": "Europe",
  "eastern-europe": "Europe",
  canada: "North America",
  usa: "North America",
  mexico: "North America",
  "central-america": "North America",
  caribbean: "North America",
  "south-america": "South America",
  oceania: "Oceania",
  "polar-regions": "Polar",
  arctic: "Polar",
  antarctica: "Polar",
};

type TravelRegion = {
  region: string;
  href: string;
  spotCount: number;
  continent: Continent | "Other";
};

const importedSpotCounts: Record<string, number> = {
  ...europeSubregionImportedSpotCounts,
};

const siteUrl =
  (Astro.site?.toString() ?? "https://sokolsky.me").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const pageTitle = "Travel";
const pageDescription = "Travel pages by region and site count.";

const guides = [
  {
    title: "Best way to see the 2027 Eclipse",
    href: "/travel/eclipse-2027/",
    note: "Aug 2, 2027 · Istanbul → Luxor or Sfax · country detail",
  },
  {
    title: "Suitcase ranking",
    href: "/travel/suitcases-ranking/",
    note: "Carry-on and checked bags that fit the four biggest U.S. airlines",
  },
] as const;

const formatRegionName = (slug: string) =>
  slug
    .replace(/^best-of-/, "")
    .split("-")
    .map((word) => (word === "usa" ? "USA" : word[0].toUpperCase() + word.slice(1)))
    .join(" ");

const regionalSpotCounts = Object.fromEntries(
  Object.entries(pageSources)
    .filter(([path]) => !path.endsWith("/best-of-world.astro"))
    .map(([path, source]) => [
      path,
      importedSpotCounts[path] ?? extractTravelSpotsFromSource(String(source)).length,
    ]),
);
const worldSpotCount = Object.values(regionalSpotCounts).reduce((sum, count) => sum + count, 0);

const regions = Object.entries(pageSources)
  .flatMap(([path, source]) => {
    const slug = path.replace("./", "").replace(/\.astro$/, "");
    const regionSlug = slug.replace(/^best-of-/, "");
    const spotCount =
      slug === "best-of-world"
        ? worldSpotCount
        : (regionalSpotCounts[path] ?? extractTravelSpotsFromSource(String(source)).length);

    return [{
      region: formatRegionName(slug),
      href: `/travel/${slug}/`,
      spotCount,
      continent: continentBySlug[regionSlug] ?? "Other",
    }];
  })
  .filter((region) => region.spotCount > 0)
  .sort((a, b) => a.region.localeCompare(b.region)) satisfies TravelRegion[];

const continentGroups = [...continentOrder, "Other" as const]
  .map((continent) => ({
    continent,
    headingId: `continent-${continent.toLowerCase().replace(/\s+/g, "-")}`,
    regions: regions.filter((region) => region.continent === continent),
  }))
  .filter((group) => group.regions.length > 0);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: regions.length,
    itemListElement: continentGroups.flatMap((group) => group.regions).map((region, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${siteUrl}${region.href}`,
      name: region.region,
    })),
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="keywords"
      content="travel directory, unique travel regions, globally distinctive places"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#f7f0e5" />
    <meta name="theme-color" content="#15120e" media="(prefers-color-scheme: dark)" />
    <meta name="msapplication-TileColor" content="#15120e" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#15120e" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Nikita Sokolsky" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <main class="page">
      <h1>Travel</h1>

      <section class="guides" aria-labelledby="guides-heading">
        <h2 id="guides-heading">Guides</h2>
        <ul class="region-list">
          {guides.map((guide) => (
            <li>
              <a href={guide.href}>
                <span>{guide.title}</span>
                <span>{guide.note}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {continentGroups.map((group) => (
        <section class="continent" aria-labelledby={group.headingId}>
          <h2 id={group.headingId}>{group.continent}</h2>
          <ul class="region-list">
            {group.regions.map((region) => (
              <li>
                <a href={region.href}>
                  <span>{region.region}</span>
                  <span>{region.spotCount.toLocaleString("en-US")} sites</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --bg: #fcfaf6;
    --text: #1d1710;
    --text-muted: #6f5d49;
    --border: #dfc9aa;
    --accent: #8d4d1f;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #15120e;
      --text: #f5eadc;
      --text-muted: #c6ad91;
      --border: #4a3a2b;
      --accent: #e3a15f;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  a {
    color: inherit;
  }

  .page {
    width: min(720px, calc(100% - 32px));
    margin: 0 auto;
    padding: 20px 0 40px;
  }

  h1 {
    margin: 0 0 16px;
    font-size: clamp(1.55rem, 4vw, 2.15rem);
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  h2 {
    margin: 0 0 10px;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .guides,
  .continent {
    margin-bottom: 28px;
  }

  .region-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .region-list li {
    border-top: 1px solid var(--border);
  }

  .region-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .region-list a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    color: inherit;
    font-size: 1.02rem;
    font-weight: 700;
    text-decoration: none;
  }

  .region-list a:hover {
    color: var(--accent);
  }

  .region-list span:last-child {
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .page {
      width: min(100% - 20px, 1120px);
    }

    .region-list a {
      font-size: 1rem;
    }
  }
</style>
