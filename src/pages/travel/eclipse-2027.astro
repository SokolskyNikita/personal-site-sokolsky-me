---
export const prerender = true;

const pageTitle = "Best way to see the 2027 Eclipse";
const pageDescription =
  "Recommended 2027 eclipse plan: Istanbul forecast hub, then Flex Luxor or Sfax (≥5 min). Also covers Egyptian Red Sea, Spain, and Morocco (4+ min).";
const themeColorLight = "#fbf8f2";
const themeColorDark = "#16120e";
const siteUrl =
  (Astro.site?.toString() ?? "https://sokolsky.me").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  datePublished: "2026-08-03",
  dateModified: "2026-08-03",
  author: {
    "@type": "Person",
    name: "Nikita Sokolsky",
  },
  about: [
    { "@type": "Thing", name: "Total solar eclipse of August 2, 2027" },
    { "@type": "Place", name: "Istanbul" },
    { "@type": "Place", name: "Luxor" },
    { "@type": "Place", name: "Sfax" },
  ],
  inLanguage: "en",
};

type DurationRow = {
  place: string;
  totality: string;
  note: string;
};

type OddsTier = {
  label: string;
  odds: string;
  plan: string;
};

type DecisionCard = {
  title: string;
  body: string;
};

type BookCategory = {
  label: string;
  items: string[];
};

type Source = {
  label: string;
  href: string;
  note: string;
};

