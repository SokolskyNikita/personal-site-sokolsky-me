    href: "https://www.lapresse.tn/2026/04/08/eclipse-solaire-historique-en-tunisie-en-2027-un-spectacle-rare-apres-122-ans-et-un-potentiel-de-milliers-de-visiteurs/",
    note: "Tunisian press on Chaffar duration and visitor potential",
  },
  {
    label: "timeanddate — Luxor",
    href: "https://www.timeanddate.com/eclipse/in/egypt/luxor?iso=20270802",
    note: "Local totality near 6m 22s",
  },
  {
    label: "TheSkyLive — Sfax",
    href: "https://theskylive.com/solar-eclipse?id=2027-08-02&geoid=2467454",
    note: "Sfax ~5m 41s",
  },
  {
    label: "US State Dept — Tunisia",
    href: "https://travel.state.gov/content/travel/en/traveladvisories/traveladvisories/tunisia-travel-advisory.html",
    note: "Level 2; Level-4 mountain/border strips incl. Orbata",
  },
  {
    label: "France Diplomatie — Tunisie",
    href: "https://www.diplomatie.gouv.fr/fr/information-par-pays/tunisie/conseils-aux-voyageurs-securite",
    note: "French security advice; Sfax not specially barred",
  },
  {
    label: "Auswärtiges Amt — Tunesien",
    href: "https://www.auswaertiges-amt.de/de/reiseundsicherheit/tunesiensicherheit-219024",
    note: "German advisory; no Sfax-specific ban",
  },
  {
    label: "Red Sea Diving Safari",
    href: "https://www.redsea-divingsafari.com/news/solar-eclipse-2027/21235",
    note: "Wadi Lahami ~6m 14s",
  },
  {
    label: "Ahram Online",
    href: "https://english.ahram.org.eg/News/569499.aspx",
    note: "Egypt tourism ministry eclipse committee",
  },
  {
    label: "Mandarin Oriental",
    href: "https://press.mandarinoriental.com/?p=18656",
    note: "Winter Palace restoration / July 2027 target",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="subject"
      content="How to maximize clear-sky odds for the August 2, 2027 total solar eclipse across Egypt, Tunisia, and other path options."
    />
    <meta name="application-name" content={pageTitle} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="keywords"
      content="2027 total solar eclipse, clear skies, Egypt, Tunisia, Sfax, Chaffar, Wadi Lahami, Luxor, Spain, Jay Anderson"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={themeColorLight} />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="msapplication-TileColor" content={themeColorDark} />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="mask-icon"
      href="/safari-pinned-tab.svg"
      color={themeColorDark}
    />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="sokolsky.me" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonicalUrl} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
  </head>
  <body>
    <main class="page">
      <header class="hero">
        <a class="home-link" href="/" aria-label="Back to home">sokolsky.me</a>
        <p class="eyebrow">Travel · August 2, 2027</p>
        <h1>Clear skies for the eclipse of the century</h1>
        <p class="dek">
          Totality lasts over six minutes in Egypt and nearly six in Tunisia.
          Cloud is rarely the problem. Dust, mobility, and where you sleep are.
        </p>
      </header>

      <article class="article">
        <section id="tradeoff" aria-labelledby="tradeoff-heading">
          <h2 id="tradeoff-heading">Pick the tradeoff</h2>
          <p>
            On Monday, 2 August 2027, the Moon’s umbra crosses southern Spain
            and Morocco in the morning, then Tunisia, Libya, and Egypt near
            midday. Greatest eclipse is in Egypt (~6m 23s). The clear-sky
            ranking on usable land is roughly
            <strong>Egypt / western desert track &gt; Tunisia (Sfax) &gt; inland
              Spain &gt; Atlantic coasts</strong
            >; Libya’s weather is excellent and off-limits.
          </p>
          <p>
            Egypt maximizes duration and climatology. Tunisia maximizes
            independent mobility and cooler mornings. Everything else is a hedge
            or a logistics preference. Use the switcher for the plan that
            matches your constraint.
          </p>
        </section>

        <div class="region-shell" data-region-shell>
          <div
            class="region-switch"
            role="tablist"
            aria-label="Eclipse destination options"
          >
            {
              regions.map((region, index) => (
                <button
                  type="button"
                  class="region-tab"
                  role="tab"
                  id={`tab-${region.id}`}
                  aria-controls={`panel-${region.id}`}
                  aria-selected={index === 0 ? "true" : "false"}
                  tabindex={index === 0 ? 0 : -1}
                  data-region={region.id}
                >
                  <span class="region-tab-label">{region.label}</span>
                  <span class="region-tab-short">{region.short}</span>
                </button>
              ))
            }
          </div>

          {
            regions.map((region, index) => (
              <div
                class="region-panel"
                role="tabpanel"
                id={`panel-${region.id}`}
                aria-labelledby={`tab-${region.id}`}
                data-panel={region.id}
                hidden={index !== 0}
              >
                <aside class="takeaways" aria-labelledby={`${region.id}-takeaways`}>
                  <h2 id={`${region.id}-takeaways`}>The short version</h2>
                  <ol>
                    {region.takeaways.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ol>
                </aside>

                <section
                  id={`${region.id}-where`}
                  aria-labelledby={`${region.id}-where-heading`}
                >
                  <h2 id={`${region.id}-where-heading`}>Where to stand</h2>
                  {region.whereIntro.map((para) => (
                    <p set:html={para} />
                  ))}
                  <div class="table-wrap">
                    <table>
                      <caption>Indicative totality</caption>
                      <thead>
                        <tr>
                          <th scope="col">Place</th>
                          <th scope="col">Totality</th>
                          <th scope="col">Role</th>
                        </tr>
                      </thead>
                      <tbody>
                        {region.durations.map((row) => (
                          <tr>
                            <th scope="row">{row.place}</th>
                            <td>{row.totality}</td>
                            <td>{row.note}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <p class="source-note">
                    Figures vary by a few seconds by exact GPS point. Fix your
                    site on Xavier Jubier’s interactive map before you commit.
                  </p>
                </section>

                <section
                  id={`${region.id}-weather`}
                  aria-labelledby={`${region.id}-weather-heading`}
                >
                  <h2 id={`${region.id}-weather-heading`}>Sky odds</h2>
                  {region.weather.map((para) => (
                    <p set:html={para} />
                  ))}
                  {region.quote && (
                    <blockquote>
                      <p>
                        <em>“{region.quote.text}”</em>
                        {" — "}
                        <a
                          href={region.quote.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {region.quote.cite}
                        </a>
                      </p>
                    </blockquote>
                  )}
                </section>

                <section
                  id={`${region.id}-plan`}
                  aria-labelledby={`${region.id}-plan-heading`}
                >
                  <h2 id={`${region.id}-plan-heading`}>The working plan</h2>
                  {region.planIntro.map((para) => (
                    <p set:html={para} />
                  ))}
                  <div class="decision-grid" aria-label="Plan choices">
                    {region.decisions.map((card) => (
                      <article>
                        <h3>{card.title}</h3>
                        <p set:html={card.body} />
                      </article>
                    ))}
                  </div>
                  {region.planNote && <p set:html={region.planNote} />}
                </section>

                <section
                  id={`${region.id}-odds`}
                  aria-labelledby={`${region.id}-odds-heading`}
                >
                  <h2 id={`${region.id}-odds-heading`}>How odds scale</h2>
                  <p>{region.oddsIntro}</p>
                  <ol class="tier-list">
                    {region.odds.map((tier) => (
                      <li>
                        <div class="tier-head">
                          <strong>{tier.label}</strong>
                          <span>{tier.odds}</span>
                        </div>
                        <p>{tier.plan}</p>
                      </li>
                    ))}
                  </ol>
                  <p>{region.oddsOutro}</p>
                </section>

                <section
                  id={`${region.id}-booking`}
                  aria-labelledby={`${region.id}-booking-heading`}
                >
                  <h2 id={`${region.id}-booking-heading`}>Booking sequence</h2>
                  <ol class="steps">
                    {region.booking.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ol>
                  {region.bookingNote && <p set:html={region.bookingNote} />}
                </section>

                <section
                  id={`${region.id}-protocol`}
                  aria-labelledby={`${region.id}-protocol-heading`}
                >
                  <h2 id={`${region.id}-protocol-heading`}>
                    Eclipse-week protocol
                  </h2>
                  <p set:html={region.protocolIntro} />
                  <ul class="plain-list">
                    {region.protocol.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                  <p>{region.protocolOutro}</p>
                </section>

                <section
                  id={`${region.id}-pitfalls`}
                  aria-labelledby={`${region.id}-pitfalls-heading`}
                >
                  <h2 id={`${region.id}-pitfalls-heading`}>
                    Failure modes
                  </h2>
                  <ul class="plain-list">
                    {region.pitfalls.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                </section>
              </div>
            ))
          }
        </div>

        <section id="sources" aria-labelledby="sources-heading">
          <h2 id="sources-heading">Sources</h2>
          <ul class="source-list">
            {
              sources.map((source) => (
                <li>
                  <a
                    href={source.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {source.label}
                  </a>
                  <span>{source.note}</span>
                </li>
              ))
            }
          </ul>
          <p class="source-note">
            Probabilities are planning estimates. No booking strategy fully
            eliminates dust — only geographic hedging across independent weather
            cells does.
          </p>
        </section>
      </article>
    </main>

    <script>
      const shell = document.querySelector("[data-region-shell]");
      if (shell) {
        const tabs = Array.from(
          shell.querySelectorAll(".region-tab"),
        );
        const panels = Array.from(
          shell.querySelectorAll(".region-panel"),
        );
        const valid = new Set(["egypt", "tunisia", "other"]);

        const activate = (id, { focus = false, pushHash = true } = {}) => {
          if (!valid.has(id)) id = "egypt";
          for (const tab of tabs) {
            const on = tab.dataset.region === id;
            tab.setAttribute("aria-selected", on ? "true" : "false");
            tab.tabIndex = on ? 0 : -1;
            if (on && focus) tab.focus();
          }
          for (const panel of panels) {
            panel.hidden = panel.dataset.panel !== id;
          }
          if (pushHash) {
            const next = `#${id}`;
            if (location.hash !== next) {
              history.replaceState(null, "", next);
            }
          }
        };

        for (const tab of tabs) {
          tab.addEventListener("click", () => {
            activate(tab.dataset.region || "egypt", { focus: false });
          });
          tab.addEventListener("keydown", (event) => {
            const keys = ["ArrowLeft", "ArrowRight", "Home", "End"];
            if (!keys.includes(event.key)) return;
            event.preventDefault();
            const i = tabs.indexOf(tab);
            let next = i;
            if (event.key === "ArrowRight") next = (i + 1) % tabs.length;
            if (event.key === "ArrowLeft")
              next = (i - 1 + tabs.length) % tabs.length;
            if (event.key === "Home") next = 0;
            if (event.key === "End") next = tabs.length - 1;
            const target = tabs[next]?.dataset.region || "egypt";
            activate(target, { focus: true });
          });
        }

        const fromHash = () => {
          const id = location.hash.replace(/^#/, "");
          activate(valid.has(id) ? id : "egypt", { pushHash: false });
        };
        window.addEventListener("hashchange", fromHash);
        fromHash();
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --bg: #fbf8f2;
    --paper: #fffdf8;
    --text: #1c1712;
    --text-soft: #3f352b;
    --muted: #746556;
    --rule: #e0d4c4;
    --accent: #9a4e1a;
    --accent-soft: #f3e6d4;
    --ok: #2f6b45;
    --selection: #ecd7b8;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua",
      Georgia, serif;
    --sans: "Avenir Next", "Segoe UI", ui-sans-serif, -apple-system,
      BlinkMacSystemFont, Helvetica, Arial, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16120e;
      --paper: #1e1914;
      --text: #f3ebe1;
      --text-soft: #d4c6b4;
      --muted: #a8947d;
      --rule: #3d3228;
      --accent: #e0a06a;
      --accent-soft: #3a2818;
      --ok: #8fd0ad;
      --selection: #4a3420;
    }
  }

  * {
    box-sizing: border-box;
  }

  ::selection {
    background: var(--selection);
    color: var(--text);
  }

  html {
    max-width: 100%;
    overflow-x: clip;
    background: var(--bg);
    color: var(--text);
    font-family: var(--serif);
    font-size: 16px;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    max-width: 100%;
    margin: 0;
    overflow-x: clip;
    background:
      radial-gradient(
        ellipse 80% 50% at 88% -10%,
        color-mix(in srgb, var(--accent-soft) 55%, transparent),
        transparent 58%
      ),
      radial-gradient(
        ellipse 55% 40% at 8% 0%,
        color-mix(in srgb, var(--accent-soft) 28%, transparent),
        transparent 52%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--bg) 92%, #d8b896) 0%,
        var(--bg) 32%
      );
  }

  .page {
    width: 100%;
    max-width: 48rem;
    margin: 0 auto;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    overflow-x: clip;
  }

  .hero {
    min-width: 0;
    display: grid;
    gap: 0.3rem;
    border-bottom: 1px solid var(--rule);
    padding: 0 0 0.85rem;
  }

  .home-link,
  .eyebrow,
  .takeaways h2,
  .tier-head span,
  th,
  .source-list span,
  .source-note,
  .region-tab {
    font-family: var(--sans);
  }

  .home-link {
    width: fit-content;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-underline-offset: 0.28em;
  }

  .home-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .eyebrow {
    margin: 0.4rem 0 0;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.45rem, 3.4vw, 2rem);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .dek {
    max-width: 40rem;
    margin: 0.15rem 0 0;
    color: var(--text-soft);
    font-size: clamp(0.95rem, 1.35vw, 1.08rem);
    line-height: 1.42;
    letter-spacing: -0.01em;
  }

  .article {
    width: 100%;
    min-width: 0;
    display: grid;
    gap: 1.55rem;
    max-width: 100%;
    margin: 0;
    padding: 0.95rem 0 2.4rem;
  }

  section {
    min-width: 0;
    scroll-margin-top: 1.25rem;
  }

  h2 {
    margin: 0 0 0.5rem;
    color: var(--text);
    font-size: clamp(1.08rem, 1.9vw, 1.28rem);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  h3 {
    margin: 0 0 0.3rem;
    color: var(--text);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  p,
  li {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.98rem;
    line-height: 1.65;
    overflow-wrap: break-word;
  }

  p + p,
  p + .table-wrap,
  .table-wrap + p,
  p + .decision-grid,
  .decision-grid + p,
  p + .tier-list,
  .tier-list + p,
  p + .steps,
  .steps + p,
  p + .plain-list,
  .plain-list + p,
  p + blockquote,
  blockquote + p {
    margin-top: 0.7rem;
  }

  a {
    color: var(--accent);
    overflow-wrap: anywhere;
    text-decoration-line: underline;
    text-decoration-thickness: 0.08em;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    text-underline-offset: 0.17em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  a:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }

  strong {
    color: var(--text);
    font-weight: 700;
  }

  em {
    font-style: italic;
  }

  .region-shell {
    display: grid;
    gap: 1.25rem;
  }

  .region-switch {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
    padding: 0.3rem;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
  }

  .region-tab {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    margin: 0;
    padding: 0.65rem 0.55rem 0.7rem;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    text-align: left;
    cursor: pointer;
    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .region-tab:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--accent-soft) 40%, transparent);
  }

  .region-tab[aria-selected="true"] {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--rule));
    background: color-mix(in srgb, var(--accent-soft) 70%, transparent);
    color: var(--text);
  }

  .region-tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .region-tab-label {
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.02em;
  }

  .region-tab-short {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .region-tab[aria-selected="true"] .region-tab-short {
    color: var(--text-soft);
  }

  .region-panel {
    display: grid;
    gap: 1.45rem;
  }

  .region-panel[hidden] {
    display: none;
  }

  .takeaways {
    border-block: 1px solid var(--rule);
    background: color-mix(in srgb, var(--accent-soft) 58%, transparent);
    padding: 0.9rem 0.85rem 1rem;
  }

  .takeaways h2 {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .takeaways ol {
    margin: 0;
    padding-left: 1.15rem;
  }

  .takeaways li {
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .takeaways li + li {
    margin-top: 0.4rem;
  }

  blockquote {
    margin: 0;
    border-block: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    padding: 0.85rem 0.95rem;
  }

  blockquote p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--rule);
    background: var(--paper);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  caption {
    caption-side: top;
    padding: 0.65rem 0.75rem 0.35rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
  }

  th,
  td {
    padding: 0.55rem 0.75rem;
    border-top: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    color: var(--muted);
