---
import TravelSpotGuide from "../../components/travel/TravelSpotGuide.astro";
import { europeSpotsBySubregion } from "../../data/europeSubregions";

const spots = europeSpotsBySubregion["western-europe"];
export const travelSpots = spots;
---

<TravelSpotGuide
  pageTitle={"Most interesting spots in Western Europe"}
  pageDescription={"A researched field guide to Western Europe's most globally distinctive places, ranked by rarity and difficulty of substitution, with Google Maps pins."}
  subject={"Unique places to visit in Western Europe"}
  keywords={"Western Europe travel, unique places Western Europe, France, Britain, Benelux, globally distinctive travel"}
  eyebrow={"Western Europe field guide"}
  dek={"A Western Europe list built for travelers who care about deep rarity first: geology, ecology, archaeology, sacred sites, difficult access and places that are hard to replace with a prettier version nearby. Covers Britain, Ireland, France and the Benelux."}
  criteriaText={"Trip estimates are per person from London via Heathrow (LHR). The origin follows the busiest-airport methodology for this region. The order is the ranking. Higher means rarer globally, more mind-expanding or harder to replace with a similar trip. Cities and urban spots in metro areas over roughly 1 million people are excluded unless the spot itself is very rarely visited by Westerners. Estimates assume economy flights where needed, midrange lodging, meals, local transfers, required fees and the shortest realistic visit."}
  tripOriginLabel={"From London"}
  mapHeading={"Pins across Western Europe"}
  mapAriaLabel={"Google Map with pins for interesting places in Western Europe"}
  mapCenter={{ lat: 49.5, lng: 2.5 }}
  mapZoom={5}
  mapErrorLabel={"Western Europe"}
  spots={spots}
/>
