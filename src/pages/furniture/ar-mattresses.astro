---
import pageData from "../../data/ar-mattresses.json";

export const prerender = true;

const pageTitle = pageData.title;
const pageDescription =
  "In-stock queen-sized mattresses in Argentina. Sorted cheapest to most expensive in USD.";
const themeColorLight = "#fcfbf8";
const themeColorDark = "#111111";
const siteUrl =
  (Astro.site?.toString() ?? "https://sokolsky.me").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
type Mattress = (typeof pageData.mattresses)[number];
const arsPerUsd = pageData.currency.arsPerUsd;
const usdFormatter = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});
const sleepQuality = (mattress: Mattress) => {
  const includes = mattress.includes.toLowerCase();
  const name = mattress.name.toLowerCase();
  let score = 18;
  if (mattress.type === "pocket") score = 42;
  else if (mattress.type === "hybrid") score = 36;
  else if (mattress.type === "spring") score = 22;
  const heightCm =
    mattress.heightCm ?? (mattress.type === "foam" ? 21 : 23);
  score += Math.min(heightCm, 34) * 0.7;
  if (/35\s*kg/.test(includes)) score += 10;
  else if (/33\s*kg/.test(includes)) score += 8;
  else if (/32\s*kg/.test(includes)) score += 7;
  else if (/30\s*kg/.test(includes)) score += 6;
  else if (/hiflex|high-density|high-pressure/.test(includes)) score += 5;
  if (/double (euro )?pillow|double pillow/.test(includes)) score += 8;
  else if (/pillow top|euro pillow|native pillow/.test(includes)) score += 5;
  if (/lumbar|hotel|biconic/.test(includes)) score += 4;
  if (includes.includes("trial")) score += 2;
  if (
    /box|compressed|bag/.test(includes) ||
    name.includes("en caja") ||
    name.includes("en bolsa")
  ) {
    score -= 7;
  }
  if (/bl 910|power|one plus|shankar|density 2|bilt/.test(`${name} ${includes}`)) {
    score += 4;
  }
  return Math.round(score * 10);
};
const mattresses = [...pageData.mattresses]
  .map((mattress) => ({
    ...mattress,
    sleepQuality: sleepQuality(mattress),
  }))
  .sort((first, second) => first.priceArsBuyNow - second.priceArsBuyNow);
const updatedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date(pageData.generatedAt));
const toUsd = (ars: number) => Math.round(ars / arsPerUsd);
const typeLabel: Record<Mattress["type"], string> = {
  foam: "Foam",
  spring: "Innerspring",
  pocket: "Pocket spring",
  hybrid: "Hybrid",
};
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  numberOfItems: mattresses.length,
  itemListElement: mattresses.map((mattress: Mattress, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Product",
      name: mattress.name,
      image: `${siteUrl}${mattress.image}`,
      url: mattress.url,
      brand: mattress.seller,
      description: mattress.includes,
      offers: {
        "@type": "Offer",
        priceCurrency: "USD",
        price: toUsd(mattress.priceArsBuyNow),
        availability: "https://schema.org/InStock",
        url: mattress.url,
      },
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="subject" content="Queen mattresses Argentina" />
    <meta name="application-name" content={pageTitle} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="keywords"
      content="colchón queen Argentina, colchón 160x200 en stock, colchón 2 plazas y media"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={themeColorLight} />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Nikita Sokolsky" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}
    ></script>
  </head>
  <body>
    <main class="page">
      <header class="page-header">
        <a class="home-link" href="/">Nikita Sokolsky</a>
        <div class="headline">
          <p class="eyebrow">Argentina furniture notes · {updatedDate}</p>
          <h1>{pageTitle}</h1>
        </div>
        <p class="lede">
          Queen mattresses listed as in stock today — 160×190 or 160×200, foam,
          spring, pocket, or hybrid. Cash prices in USD at the MEP rate ($1 = {
            new Intl.NumberFormat("es-AR").format(arsPerUsd)
          } ARS).
        </p>
        <fieldset class="rank-toggle" aria-label="Rank by">
          <legend>Rank by</legend>
          <label>
            <input type="radio" name="rank" value="price" autocomplete="off" checked />
            <span>Price</span>
          </label>
          <label>
            <input type="radio" name="rank" value="quality" autocomplete="off" />
            <span>Sleep quality</span>
          </label>
        </fieldset>
      </header>

      <ol class="bed-list">
        {
          mattresses.map((mattress, index) => (
            <li data-price={mattress.priceArsBuyNow} data-quality={mattress.sleepQuality}>
              <article class="bed-card">
                <a class="photo-link" href={mattress.url} target="_blank" rel="noreferrer noopener">
                  <img src={mattress.image} alt={mattress.imageAlt} width="900" height="900" />
                </a>
                <div class="bed-copy">
                  <p class="rank">#{index + 1}</p>
                  <h2>
                    <a href={mattress.url} target="_blank" rel="noreferrer noopener">
                      {mattress.name}
                    </a>
                  </h2>
                  <p class="seller">{mattress.seller}</p>
                  <p class:list={["sit", mattress.type === "hybrid" && "sit-recessed"]}>
                    {typeLabel[mattress.type]}
                    {mattress.heightCm ? ` · ${mattress.heightCm} cm` : ""}
                  </p>
                  <p class="price">
                    <span class="usd">{usdFormatter.format(toUsd(mattress.priceArsBuyNow))}</span>
                  </p>
                  <p class="price-note">{mattress.priceNote}</p>
                  <dl>
                    <div>
                      <dt>Size</dt>
                      <dd>
                        {mattress.sizeCm} · {mattress.sizeLabel}
                      </dd>
                    </div>
                    <div>
                      <dt>Includes</dt>
                      <dd>{mattress.includes}</dd>
                    </div>
                    <div>
                      <dt>Where</dt>
                      <dd>
                        {mattress.city}
                        {mattress.shipsNationally ? " · ships nationally" : ""}
                      </dd>
                    </div>
                    <div>
                      <dt>Showroom</dt>
                      <dd>
                        {mattress.hasShowroom ? (
                          <>
                            {mattress.showroomNeighborhood}
                            {" · "}
                            {mattress.showroomOnGoogleMaps && mattress.showroomMapsUrl ? (
                              <a
                                href={mattress.showroomMapsUrl}
                                target="_blank"
                                rel="noreferrer noopener"
                              >
                                {mattress.showroomAddress}
                              </a>
                            ) : (
                              mattress.showroomAddress
                            )}
                            {!mattress.showroomOnGoogleMaps && (
                              <span class="showroom-flag"> · not on Google Maps</span>
                            )}
                          </>
                        ) : (
                          "No showroom"
                        )}
                      </dd>
                    </div>
                  </dl>
                  <a class="buy" href={mattress.url} target="_blank" rel="noreferrer noopener">
                    Open listing
                  </a>
                </div>
              </article>
            </li>
          ))
        }
      </ol>

      <aside class="notes">
        <h2>What did not make the list</h2>
        <ul>
          {
            pageData.excluded.map((item) => (
              <li>
                <strong>{item.name}.</strong> {item.reason}
              </li>
            ))
          }
        </ul>
        <p>
          Sleep quality ranks construction, not reviews. Pocket springs and
          hybrids sit above Bonnell. Taller beds and higher-density foam with a
          pillow layer rise. Boxed 20 cm foam falls.
        </p>
        <p>
          Showroom is the seller’s closest walk-in store to Palermo. Addresses
          were confirmed operational with the Google Maps Places API. Sealy’s
          official Mercado Libre shop and ESTEBANTABLADA have no public
          showroom pin.
        </p>
        <p>
          Related:{" "}
          <a href="/furniture/ar-beds">Queen beds in Argentina</a>
          {" · "}
          <a href="/furniture/buenos-aires">Buenos Aires furniture brands</a>.
        </p>
      </aside>
    </main>
    <script>
      const list = document.querySelector(".bed-list");
      const rankInputs = document.querySelectorAll('input[name="rank"]');
      if (list instanceof HTMLOListElement && rankInputs.length) {
        const cards = Array.from(list.children);
        const applyRank = (mode: "price" | "quality") => {
          const sorted = [...cards].sort((first, second) => {
            if (!(first instanceof HTMLElement) || !(second instanceof HTMLElement)) {
              return 0;
            }
            if (mode === "quality") {
              return (
                Number(second.dataset.quality) - Number(first.dataset.quality) ||
                Number(first.dataset.price) - Number(second.dataset.price)
              );
            }
            return Number(first.dataset.price) - Number(second.dataset.price);
          });
          list.append(...sorted);
          sorted.forEach((card, index) => {
            const rank = card.querySelector(".rank");
            if (rank) rank.textContent = `#${index + 1}`;
          });
          const url = new URL(window.location.href);
          if (mode === "quality") url.searchParams.set("rank", "quality");
          else url.searchParams.delete("rank");
          history.replaceState(null, "", url);
        };
        const requested =
          new URLSearchParams(window.location.search).get("rank") === "quality"
            ? "quality"
            : "price";
        rankInputs.forEach((input) => {
          if (!(input instanceof HTMLInputElement)) return;
          input.checked = input.value === requested;
          input.addEventListener("change", () => {
            if (input.checked && (input.value === "price" || input.value === "quality")) {
              applyRank(input.value);
            }
          });
        });
        if (requested === "quality") applyRank("quality");
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --bg: #fcfbf8;
    --surface: #fffefa;
    --text: #181512;
    --text-muted: #6d6258;
    --border: #d9cbb9;
    --accent: #4b3323;
    --accent-soft: #ece0d3;
    --link: #2b1c13;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #10100e;
      --surface: #171513;
      --text: #f4eee6;
      --text-muted: #afa59a;
      --border: #332d25;
      --accent: #ead8c5;
      --accent-soft: #2d241d;
      --link: #f7eadf;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
      Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
  }

  a {
    color: var(--link);
    text-decoration-color: color-mix(in srgb, var(--link), transparent 62%);
    text-underline-offset: 0.2em;
  }

  .page {
    width: min(100%, 52rem);
    margin: 0 auto;
    padding: clamp(0.75rem, 1.8vw, 1.8rem);
  }

  .page-header {
    display: grid;
    gap: 0.7rem;
    padding: 0.9rem 0 1.2rem;
  }

  .home-link {
    width: fit-content;
    color: var(--text-muted);
    font-size: 0.86rem;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.85rem, 3.8vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .lede,
  .price-note,
  .seller,
  .notes {
    color: var(--text-muted);
  }

  .sit {
    width: fit-content;
    margin-top: 0.15rem;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .sit-recessed {
    color: var(--accent);
  }

  .lede {
    max-width: 40rem;
    font-size: 1.02rem;
  }

  .rank-toggle {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    align-items: center;
    width: fit-content;
    margin: 0.15rem 0 0;
    padding: 0.28rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }

  .rank-toggle legend {
    padding: 0 0.55rem 0 0.4rem;
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rank-toggle label {
    cursor: pointer;
  }

  .rank-toggle input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .rank-toggle span {
    display: block;
    padding: 0.38rem 0.7rem;
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .rank-toggle input:checked + span {
    background: var(--accent);
    color: var(--bg);
  }

  .rank-toggle input:focus-visible + span {
    outline: 2px solid color-mix(in srgb, var(--accent), transparent 30%);
    outline-offset: 2px;
  }

  .bed-list {
    display: grid;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bed-card {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) minmax(0, 1fr);
    gap: 1rem 1.15rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 1.1rem;
    background: var(--surface);
  }

  .photo-link {
    display: block;
    align-self: start;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .photo-link img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .bed-copy {
    display: grid;
    align-content: start;
    gap: 0.32rem;
  }

  .rank {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h2 {
    font-size: 1.28rem;
    letter-spacing: -0.02em;
  }

  h2 a {
    text-decoration: none;
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    align-items: baseline;
    margin-top: 0.2rem;
  }

  .usd {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .price-note {
    font-size: 0.88rem;
  }

  dl {
    display: grid;
    gap: 0.45rem;
    margin: 0.45rem 0 0.2rem;
  }

  dl div {
    display: grid;
    gap: 0.08rem;
  }

  dt {
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: 0.92rem;
  }

  .buy {
    width: fit-content;
    margin-top: 0.35rem;
    font-weight: 700;
  }

  .showroom-flag {
    color: var(--text-muted);
  }

  .notes {
    margin-top: 1.8rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
  }

  .notes h2 {
    margin-bottom: 0.55rem;
    color: var(--text);
    font-size: 1.05rem;
  }

  .notes ul {
    margin: 0 0 0.9rem;
    padding-left: 1.1rem;
  }

  .notes li + li {
    margin-top: 0.45rem;
  }

  @media (max-width: 640px) {
    .bed-card {
      grid-template-columns: 1fr;
    }
  }
</style>
