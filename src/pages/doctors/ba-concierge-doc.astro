const englishCount = options.filter((option) => option.englishFit === "strong").length;
const sameDayCount = options.filter((option) => option.sameDay).length;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  numberOfItems: options.length,
  itemListElement: options.map((option) => ({
    "@type": "ListItem",
    position: option.rank,
    item: {
      "@type": option.kind === "doctor" ? "Physician" : "MedicalBusiness",
      name: option.name,
      url: option.url,
      description: option.notes,
      address: option.location,
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="subject" content="Best BA concierge docs" />
    <meta name="application-name" content={pageTitle} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="keywords"
      content="concierge doctor Buenos Aires, English speaking GP Buenos Aires, same-day doctor Buenos Aires, Hospital Alemán international patients, CareThere Buenos Aires, TravelDoctores"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={themeColorLight} />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="msapplication-TileColor" content={themeColorDark} />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color={themeColorDark} />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Nikita Sokolsky" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <main class="page">
      <header class="page-header">
        <a class="home-link" href="/">Nikita Sokolsky</a>
        <div class="headline">
          <p class="eyebrow">Buenos Aires guide</p>
          <h1>{pageTitle}</h1>
          <p class="intro">
            Ranked for US-style concierge that can also order labs and see you
            in a real BA office if needed. English hospital desks first; named
            GPs next; remote-only or no-lab video last. Wealthy Argentines
            usually join Alemán Plan Médico, Italiano Plan de Salud, or a
            premium prepaga plus Otamendi Concierge — those need DNI or a local
            plan, so they are not ranked here. ARS at 1,550 = $1 (blue venta,
            22 Aug 2026). Confirm language and the quote before you pay.
          </p>
        </div>
        <div class="toolbar" aria-label="Concierge doctor filters">
          <fieldset class="extras-toggle">
            <legend>Filter</legend>
            <input id="filter-english" type="checkbox" autocomplete="off" />
            <label for="filter-english">English ({englishCount})</label>
            <input id="filter-same-day" type="checkbox" autocomplete="off" />
            <label for="filter-same-day">Same-day ({sameDayCount})</label>
          </fieldset>
          <p class="meta" id="list-status">
            Updated {updatedDate}. {options.length} options.
          </p>
        </div>
      </header>

      <section class="doctor-list" aria-label="Ranked concierge doctor options">
        <div class="doctor-row doctor-head" aria-hidden="true">
          <span>Rank</span>
          <span>Option</span>
          <span>How to book</span>
          <span>Notes</span>
          <span>USD price</span>
        </div>

        {
          options.map((option) => (
            <article
              class="doctor-row"
              data-english={String(option.englishFit === "strong")}
              data-same-day={String(option.sameDay)}
            >
              <p class="rank" aria-label={`Rank ${option.rank}`}>
                {option.rank}
              </p>
              <div class="identity">
                <h2 class="doctor-name">
                  <a href={option.url} target="_blank" rel="noreferrer noopener">
                    {option.name}
                  </a>
                </h2>
                <p class="kind">
                  {kindLabel[option.kind]}
                  <span class="loc">{option.location}</span>
                </p>
              </div>
              <div class="booking">
                <p class="booking-lead">{option.bookingLead}</p>
                {option.bookingLinks.length > 0 && (
                  <p class="booking-links">
                    {option.bookingLinks.map((link, index) => (
                      <>
                        {index > 0 && <span class="booking-sep"> · </span>}
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noreferrer noopener"
                        >
                          {link.label}
                        </a>
                      </>
                    ))}
                  </p>
                )}
              </div>
              <p class="notes">{option.notes}</p>
              <p
                class:list={[
                  "price",
                  option.priceKind === "visit" && "price-visit",
                  option.priceKind === "quote" && "price-quote",
                  option.priceKind === "unknown" && "price-unknown",
                ]}
              >
                {option.priceLabel}
              </p>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>

<script is:inline>
  const englishFilter = document.querySelector("#filter-english");
  const sameDayFilter = document.querySelector("#filter-same-day");
  const listStatus = document.querySelector("#list-status");
  const optionRows = [...document.querySelectorAll(".doctor-row:not(.doctor-head)")];
  const totalCount = optionRows.length;

  const hasEnabledUrlParam = (params, key) => {
    const value = params.get(key);
    return value === "1" || value === "true" || value === "yes";
  };

  const updateFilterUrl = (englishOnly, sameDayOnly) => {
    const url = new URL(window.location.href);
    url.searchParams.delete("english");
    url.searchParams.delete("house");
    url.searchParams.delete("sameday");
    if (englishOnly) url.searchParams.set("english", "1");
    if (sameDayOnly) url.searchParams.set("sameday", "1");

    const nextUrl = `${url.pathname}${url.search}${url.hash}`;
    const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (nextUrl !== currentUrl) {
      window.history.replaceState(null, "", nextUrl);
    }
  };

  const applyFilters = ({ syncUrl = true } = {}) => {
    const englishOnly = Boolean(englishFilter?.checked);
    const sameDayOnly = Boolean(sameDayFilter?.checked);
    let visibleCount = 0;

    for (const row of optionRows) {
      const english = row.dataset.english === "true";
      const sameDay = row.dataset.sameDay === "true";
      const visible = (!englishOnly || english) && (!sameDayOnly || sameDay);
      row.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    if (listStatus) {
      const parts = [];
      if (englishOnly) parts.push("English");
      if (sameDayOnly) parts.push("same-day");
      listStatus.textContent = parts.length
        ? `Showing ${visibleCount} option${visibleCount === 1 ? "" : "s"} · ${parts.join(" · ")}.`
        : `Showing all ${totalCount} options.`;
    }

    if (syncUrl) updateFilterUrl(englishOnly, sameDayOnly);
  };

  const applyFiltersFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    if (englishFilter) englishFilter.checked = hasEnabledUrlParam(params, "english");
    if (sameDayFilter) {
      sameDayFilter.checked =
        hasEnabledUrlParam(params, "sameday") || hasEnabledUrlParam(params, "house");
    }
    applyFilters({ syncUrl: false });
  };

  englishFilter?.addEventListener("change", () => applyFilters());
  sameDayFilter?.addEventListener("change", () => applyFilters());
  applyFiltersFromUrl();
  window.addEventListener("pageshow", applyFiltersFromUrl);
  window.addEventListener("popstate", applyFiltersFromUrl);
</script>

<style>
  :root {
    color-scheme: light dark;
    --bg: #fcfaf7;
    --surface: #fffdf8;
    --surface-soft: #efe7db;
    --text: #181612;
    --text-muted: #6f675c;
    --border: #d9cfc0;
    --border-strong: #c8baa8;
    --accent: #28402f;
    --accent-soft: #dfe8d7;
    --link: #17281d;
    --shadow: 0 20px 60px rgba(61, 44, 22, 0.08);
    --yes: #2f5d3a;
    --yes-soft: #dcead9;
    --verify: #8a6a2f;
    --verify-soft: #f3e7c8;
    --private: #6f675c;
    --private-soft: #ebe4d8;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #10100e;
      --surface: #171613;
      --surface-soft: #211f1a;
      --text: #f2eee7;
      --text-muted: #aaa297;
      --border: #343027;
      --border-strong: #4a4338;
      --accent: #dce8d2;
      --accent-soft: #263022;
      --link: #f6f1e8;
      --shadow: none;
      --yes: #b7d4b8;
      --yes-soft: #243126;
      --verify: #e2c788;
      --verify-soft: #332914;
      --private: #aaa297;
      --private-soft: #26231e;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
    font-size: 16px;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    margin: 0;
    background:
      radial-gradient(
        circle at 15% 0%,
        color-mix(in srgb, var(--accent-soft), transparent 35%),
        transparent 32rem
      ),
      var(--bg);
  }

  a {
    color: var(--link);
    text-decoration-color: color-mix(in srgb, var(--link), transparent 62%);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

