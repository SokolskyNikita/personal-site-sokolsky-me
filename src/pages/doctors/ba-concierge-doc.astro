---
export const prerender = true;

const pageTitle = "Best BA concierge docs";
const pageDescription =
  "Ranked Buenos Aires concierge-doctor options for foreigners: English, prescribing, lab orders, a physical BA office when needed, and USD visit or monthly prices.";
const themeColorLight = "#fcfaf7";
const themeColorDark = "#111111";
const siteUrl =
  (Astro.site?.toString() ?? "https://sokolsky.me").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const updatedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date());

type EnglishFit = "strong" | "mixed" | "weak";
type OptionKind = "doctor" | "hospital-desk" | "clinic" | "telehealth";
type PriceKind = "visit" | "quote" | "unknown";

type BookingLink = {
  label: string;
  href: string;
};

type ConciergeOption = {
  rank: number;
  name: string;
  kind: OptionKind;
  url: string;
  location: string;
  bookingLead: string;
  bookingLinks: BookingLink[];
  notes: string;
  englishLabel: string;
  englishFit: EnglishFit;
  sameDay: boolean;
  priceLabel: string;
  priceKind: PriceKind;
};

const kindLabel: Record<OptionKind, string> = {
  doctor: "Named doctor",
  "hospital-desk": "Hospital desk",
  clinic: "Clinic",
  telehealth: "Telehealth",
};

const options: ConciergeOption[] = [
  {
