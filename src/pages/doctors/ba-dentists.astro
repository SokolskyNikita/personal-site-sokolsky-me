---
import pageData from "../../data/ba-dentists.json";

export const prerender = true;

const pageTitle = pageData.title;
const pageDescription =
  "Ranked general dental clinics in CABA for cleaning, whitening, and small fillings, scored mainly on published equipment. English is a filter, not a ranking bonus.";
const themeColorLight = "#fcfaf7";
const themeColorDark = "#111111";
const siteUrl =
  (Astro.site?.toString() ?? "https://sokolsky.me").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
type Clinic = (typeof pageData.clinics)[number];
const clinics = pageData.clinics;
const updatedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date(pageData.generatedAt));
const formatter = new Intl.NumberFormat("en-US", {
  maximumFractionDigits: 0,
});
const collator = new Intl.Collator("en", {
  sensitivity: "base",
  numeric: true,
});
const kindLabel: Record<Clinic["kind"], string> = {
  clinic: "Clinic",
  hospital: "Hospital",
  boutique: "Boutique",
};
const neighborhoodCounts = clinics.reduce((counts, clinic: Clinic) => {
  counts.set(clinic.neighborhood, (counts.get(clinic.neighborhood) ?? 0) + 1);
  return counts;
}, new Map<string, number>());
const neighborhoodOptions = [...neighborhoodCounts.entries()]
  .sort(
    ([nameA, countA], [nameB, countB]) =>
      countB - countA || collator.compare(nameA, nameB),
  )
  .map(([name, count]) => ({ name, count }));
const englishCount = clinics.filter(
  (clinic: Clinic) => clinic.englishSupport.fit === "strong",
).length;
const googleMapsApiKey =
  import.meta.env.GOOGLE_MAPS_API_KEY_PUBLIC ??
  process.env.GOOGLE_MAPS_API_KEY_PUBLIC ??
  "";
const mapsIcon = `<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false"><path fill="#1a73e8" d="M12 2.2c3.9 0 7.1 3.1 7.1 7 0 5.1-7.1 12.6-7.1 12.6S4.9 14.3 4.9 9.2c0-3.9 3.2-7 7.1-7Z"/><path fill="#34a853" d="M7.2 14.1 12 21.8l4.8-7.7-4.8-2.8-4.8 2.8Z"/><path fill="#fbbc04" d="M4.9 9.2c0 1.8.9 3.5 2.3 4.9l4.8-2.8V2.2c-3.9 0-7.1 3.1-7.1 7Z"/><path fill="#ea4335" d="M19.1 9.2c0 1.8-.9 3.5-2.3 4.9L12 11.3V2.2c3.9 0 7.1 3.1 7.1 7Z"/><circle cx="12" cy="9.3" r="2.45" fill="#fff"/></svg>`;
const clinicMapData = clinics.map((clinic: Clinic) => ({
  id: clinic.id,
  name: clinic.name,
  googleMapsUrl: clinic.googleMapsUrl,
  neighborhood: clinic.neighborhood,
  englishFit: clinic.englishSupport.fit,
  position: clinic.location,
}));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  numberOfItems: clinics.length,
  itemListElement: clinics.map((clinic) => ({
    "@type": "ListItem",
    position: clinic.rank,
    item: {
      "@type": clinic.kind === "hospital" ? "Hospital" : "Dentist",
      name: clinic.name,
      url: clinic.officialUrl,
      description: clinic.notes,
      address: clinic.fullAddress,
      telephone: clinic.phone || undefined,
      geo: {
        "@type": "GeoCoordinates",
        latitude: clinic.location.lat,
        longitude: clinic.location.lng,
      },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: clinic.rating.toFixed(1),
        ratingCount: clinic.reviewCount,
      },
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="subject" content="Best dental clinics in Buenos Aires" />
    <meta name="application-name" content={pageTitle} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="keywords"
      content="best dentist Buenos Aires, dental clinic Buenos Aires, English speaking dentist Buenos Aires, clínica dental CABA, odontólogo Recoleta Palermo"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={themeColorLight} />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="msapplication-TileColor" content={themeColorDark} />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color={themeColorDark} />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Nikita Sokolsky" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <main class="page">
      <header class="page-header">
        <a class="home-link" href="/">Nikita Sokolsky</a>
        <div class="headline">
          <p class="eyebrow">Buenos Aires guide</p>
          <h1>{pageTitle}</h1>
          <p class="intro">
            A CABA ranking for routine dentistry — cleaning, whitening, and
            small fillings — scored on published equipment. English is a filter,
            not a ranking bonus.
          </p>
        </div>
        <div class="toolbar" aria-label="Dental clinic filters">
          <fieldset class="extras-toggle">
            <legend>Filter</legend>
            <input id="filter-english" type="checkbox" autocomplete="off" />
            <label for="filter-english">Official English ({englishCount})</label>
          </fieldset>
          <label class="filter-dropdown" for="neighborhood-filter">
            <span>Neighborhood</span>
            <select id="neighborhood-filter" name="neighborhood" autocomplete="off">
              <option value="">All ({clinics.length})</option>
              {neighborhoodOptions.map((option) => (
                <option value={option.name}>
                  {option.name} ({option.count})
                </option>
              ))}
            </select>
          </label>
          <p class="meta" id="list-status" data-updated={`Updated ${updatedDate}`}>
            Updated {updatedDate}. Showing all {clinics.length} clinics.
          </p>
        </div>
      </header>

      <section class="clinic-list" aria-label="Ranked Buenos Aires dental clinics">
        <div class="clinic-row clinic-head" aria-hidden="true">
          <span>Rank</span>
          <span>Clinic</span>
          <span>How to book</span>
          <span>Notes</span>
          <span>English</span>
          <span>Google</span>
        </div>

        {clinics.map((clinic) => (
          <article
            class="clinic-row"
            data-english={String(clinic.englishSupport.fit === "strong")}
            data-neighborhood={clinic.neighborhood}
          >
            <p class="rank" aria-label={`Rank ${clinic.rank}`}>
              {clinic.rank}
              <span class="score">{clinic.score}</span>
            </p>
            <div class="identity">
              <h2 class="clinic-name">
                <a
                  href={clinic.officialUrl}
                  target="_blank"
                  rel="noreferrer noopener"
                >
                  {clinic.name}
                </a>
              </h2>
              <p class="kind">
                {kindLabel[clinic.kind]}
                <span class="loc">{clinic.neighborhood}</span>
              </p>
              <p class="best-for">{clinic.bestFor}</p>
              {clinic.equipment.length > 0 && (
                <p class="kit">{clinic.equipment.join(" · ")}</p>
              )}
            </div>
            <div class="booking">
              <p class="booking-lead">{clinic.bookingLead}</p>
              {clinic.bookingLinks.length > 0 && (
                <p class="booking-links">
                  {clinic.bookingLinks.map((link, index) => (
                    <>
                      {index > 0 && <span class="booking-sep"> · </span>}
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noreferrer noopener"
                      >
                        {link.label}
                      </a>
                    </>
                  ))}
                </p>
              )}
              <p class="address-line">
                <a
                  class="maps-link"
                  href={clinic.googleMapsUrl}
                  target="_blank"
                  rel="noreferrer noopener"
                  aria-label={`Open ${clinic.name} on Google Maps`}
                >
                  <span class="maps-icon" set:html={mapsIcon} />
                  {clinic.address}
                </a>
              </p>
            </div>
            <p class="notes">{clinic.notes} {clinic.caution}</p>
            <p
              class:list={[
                "english",
                clinic.englishSupport.fit === "strong" && "english-strong",
                clinic.englishSupport.fit === "mixed" && "english-mixed",
                clinic.englishSupport.fit === "none" && "english-none",
              ]}
            >
              {clinic.englishSupport.label}
            </p>
            <p
              class="rating"
              aria-label={`${clinic.rating.toFixed(1)} Google Maps rating from ${formatter.format(clinic.reviewCount)} ratings`}
            >
              <span class="rating-score">{clinic.rating.toFixed(1)}</span>
              <span class="review-count">
                {formatter.format(clinic.reviewCount)} ratings
              </span>
            </p>
          </article>
        ))}
      </section>

      <section class="clinic-map-section" aria-labelledby="clinic-map-heading">
        <div class="map-copy">
          <h2 id="clinic-map-heading">Clinic locations</h2>
        </div>
        {googleMapsApiKey ? (
          <>
            <p id="clinic-map-status" class="map-status" hidden></p>
            <div
              id="clinic-map"
              class="clinic-map"
              aria-label="Google Map with pins for Buenos Aires dental clinics"
            ></div>
          </>
        ) : (
          <p class="map-unavailable">
            Map unavailable because the Google Maps public key is not configured.
          </p>
        )}
      </section>
    </main>
  </body>
</html>

<script is:inline define:vars={{ googleMapsApiKey, clinicMapData }}>
  if (googleMapsApiKey) {
    ((g) => {
      let h;
      let a;
      let k;
      const p = "The Google Maps JavaScript API";
      const c = "google";
      const l = "importLibrary";
      const q = "__ib__";
      const m = document;
      let b = window;
      b = b[c] || (b[c] = {});
      const d = b.maps || (b.maps = {});
      const r = new Set();
      const e = new URLSearchParams();
      const u = () =>
        h ||
        (h = new Promise(async (resolve, reject) => {
          await (a = m.createElement("script"));
          e.set("libraries", [...r] + "");
          for (k in g) {
            e.set(k.replace(/[A-Z]/g, (t) => `_${t[0].toLowerCase()}`), g[k]);
          }
          e.set("callback", `${c}.maps.${q}`);
          a.src = `https://maps.${c}apis.com/maps/api/js?${e}`;
          d[q] = resolve;
          a.onerror = () => (h = reject(Error(`${p} could not load.`)));
          a.nonce = m.querySelector("script[nonce]")?.nonce || "";
          m.head.append(a);
        }));
      d[l]
        ? console.warn(`${p} only loads once. Ignoring:`, g)
        : (d[l] = (f, ...n) => r.add(f) && u().then(() => d[l](f, ...n)));
    })({
      key: googleMapsApiKey,
      v: "weekly",
    });
  }

  const englishFilter = document.querySelector("#filter-english");
  const neighborhoodFilter = document.querySelector("#neighborhood-filter");
  const listStatus = document.querySelector("#list-status");
  const clinicRows = [...document.querySelectorAll(".clinic-row:not(.clinic-head)")];
  const mapElement = document.querySelector("#clinic-map");
  const mapStatus = document.querySelector("#clinic-map-status");
  const updatedLabel = listStatus?.dataset.updated ?? "";
  const buenosAiresCenter = { lat: -34.588, lng: -58.41 };
  const markerRecords = [];
  let clinicMap;
  let infoWindow;
  const totalCount = clinicRows.length;

  const escapeHtml = (value) =>
    String(value).replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[character]);

  const hasEnabledUrlParam = (params, key) => {
    const value = params.get(key);
    return value === "1" || value === "true" || value === "yes";
  };

  const getVisibleClinics = (englishOnly, selectedNeighborhood) =>
    clinicMapData.filter(
      (clinic) =>
        (!englishOnly || clinic.englishFit === "strong") &&
        (!selectedNeighborhood || clinic.neighborhood === selectedNeighborhood),
    );

  const fitMapToMarkers = (visibleRecords) => {
    if (!clinicMap || !window.google?.maps || visibleRecords.length === 0) return;
    if (visibleRecords.length === 1) {
      clinicMap.setCenter(visibleRecords[0].clinic.position);
      clinicMap.setZoom(14);
      return;
    }
    const bounds = new google.maps.LatLngBounds();
    for (const { clinic } of visibleRecords) {
      bounds.extend(clinic.position);
    }
    clinicMap.fitBounds(bounds, 44);
  };

  const syncMapMarkers = (englishOnly, selectedNeighborhood) => {
    if (!clinicMap) return;
    const visibleIds = new Set(
      getVisibleClinics(englishOnly, selectedNeighborhood).map((clinic) => clinic.id),
    );
    const visibleRecords = [];
    for (const record of markerRecords) {
      const isVisible = visibleIds.has(record.clinic.id);
      record.marker.setMap(isVisible ? clinicMap : null);
      if (isVisible) visibleRecords.push(record);
    }
    fitMapToMarkers(visibleRecords);
  };

  const updateFilterUrl = (englishOnly, selectedNeighborhood) => {
    const url = new URL(window.location.href);
    url.searchParams.delete("english");
    url.searchParams.delete("neighborhood");
    if (englishOnly) url.searchParams.set("english", "1");
    if (selectedNeighborhood) url.searchParams.set("neighborhood", selectedNeighborhood);
    const nextUrl = `${url.pathname}${url.search}${url.hash}`;
    const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (nextUrl !== currentUrl) {
      window.history.replaceState(null, "", nextUrl);
    }
  };

  const applyFilters = ({ syncUrl = true } = {}) => {
    const englishOnly = Boolean(englishFilter?.checked);
    const selectedNeighborhood = neighborhoodFilter?.value ?? "";
    let visibleCount = 0;

    for (const row of clinicRows) {
      const english = row.dataset.english === "true";
      const neighborhoodMismatch =
        Boolean(selectedNeighborhood) && row.dataset.neighborhood !== selectedNeighborhood;
      const visible = (!englishOnly || english) && !neighborhoodMismatch;
      row.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    if (listStatus) {
      const parts = [];
      if (englishOnly) parts.push("official English");
      if (selectedNeighborhood) parts.push(selectedNeighborhood);
      const resultSummary = parts.length
        ? `Showing ${visibleCount} clinic${visibleCount === 1 ? "" : "s"} · ${parts.join(" · ")}.`
        : `Showing all ${totalCount} clinics.`;
      listStatus.textContent = updatedLabel
        ? `${updatedLabel} · ${resultSummary}`
        : resultSummary;
    }

    if (syncUrl) updateFilterUrl(englishOnly, selectedNeighborhood);
    syncMapMarkers(englishOnly, selectedNeighborhood);
  };

  const applyFiltersFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    if (englishFilter) englishFilter.checked = hasEnabledUrlParam(params, "english");
    if (neighborhoodFilter) {
      const value = params.get("neighborhood") ?? "";
      const hasOption = [...neighborhoodFilter.options].some((option) => option.value === value);
      neighborhoodFilter.value = hasOption ? value : "";
    }
    applyFilters({ syncUrl: false });
  };

  const initClinicMap = async () => {
    if (!mapElement || !googleMapsApiKey || !window.google?.maps?.importLibrary) return;
    const { Map, InfoWindow } = await google.maps.importLibrary("maps");
    await google.maps.importLibrary("marker");
    clinicMap = new Map(mapElement, {
      center: buenosAiresCenter,
      clickableIcons: false,
      fullscreenControl: true,
      mapTypeControl: false,
      streetViewControl: false,
      zoom: 12,
    });
    infoWindow = new InfoWindow();
    for (const clinic of clinicMapData) {
      const marker = new google.maps.Marker({
        map: clinicMap,
        position: clinic.position,
        title: clinic.name,
      });
      marker.addListener("click", () => {
        infoWindow.setContent(
          `<strong>${escapeHtml(clinic.name)}</strong><br><a href="${escapeHtml(clinic.googleMapsUrl)}" target="_blank" rel="noreferrer noopener">Open in Google Maps</a>`,
        );
        infoWindow.open(clinicMap, marker);
      });
      markerRecords.push({ clinic, marker });
    }
    syncMapMarkers(
      englishFilter?.checked ?? false,
      neighborhoodFilter?.value ?? "",
    );
  };

  englishFilter?.addEventListener("change", () => applyFilters());
  neighborhoodFilter?.addEventListener("change", () => applyFilters());
  applyFiltersFromUrl();
  window.addEventListener("pageshow", applyFiltersFromUrl);
  window.addEventListener("popstate", applyFiltersFromUrl);
  initClinicMap().catch((error) => {
    console.error("Unable to initialize dental clinic map", error);
    if (mapStatus) {
      mapStatus.hidden = false;
      mapStatus.textContent = "Map unavailable. Clinic list still works.";
    }
  });
</script>

<style>
  :root {
    color-scheme: light dark;
    --bg: #fcfaf7;
    --surface: #fffdf8;
    --surface-soft: #efe7db;
    --text: #181612;
    --text-muted: #6f675c;
    --border: #d9cfc0;
    --border-strong: #c8baa8;
    --accent: #28402f;
    --accent-soft: #dfe8d7;
    --link: #17281d;
    --shadow: 0 20px 60px rgba(61, 44, 22, 0.08);
    --yes: #2f5d3a;
    --yes-soft: #dcead9;
    --verify: #8a6a2f;
    --verify-soft: #f3e7c8;
    --private: #6f675c;
    --private-soft: #ebe4d8;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #10100e;
      --surface: #171613;
      --surface-soft: #211f1a;
      --text: #f2eee7;
      --text-muted: #aaa297;
      --border: #343027;
      --border-strong: #4a4338;
      --accent: #dce8d2;
      --accent-soft: #263022;
      --link: #f6f1e8;
      --shadow: none;
      --yes: #b7d4b8;
      --yes-soft: #243126;
      --verify: #e2c788;
      --verify-soft: #332914;
      --private: #aaa297;
      --private-soft: #26231e;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
    font-size: 16px;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    margin: 0;
    background:
      radial-gradient(
        circle at 15% 0%,
        color-mix(in srgb, var(--accent-soft), transparent 35%),
        transparent 32rem
      ),
      var(--bg);
  }

  a {
    color: var(--link);
    text-decoration-color: color-mix(in srgb, var(--link), transparent 62%);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .page {
    width: min(100%, 84rem);
    margin: 0 auto;
    padding:
      max(0.75rem, env(safe-area-inset-top))
      max(clamp(0.7rem, 1.6vw, 1.25rem), env(safe-area-inset-right))
      max(1.25rem, env(safe-area-inset-bottom))
      max(clamp(0.7rem, 1.6vw, 1.25rem), env(safe-area-inset-left));
  }

  .page-header {
    display: grid;
    gap: 0.55rem;
    padding: 0.35rem 0 0.65rem;
  }

  .home-link {
    width: fit-content;
    color: var(--text-muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .home-link:hover {
    color: var(--text);
  }

  .headline {
    display: grid;
    gap: 0.28rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .intro {
    margin: 0;
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
  }

  .extras-toggle {
    display: flex;
    width: fit-content;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0.28rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface), transparent 6%);
    box-shadow: var(--shadow);
  }

  .extras-toggle legend {
    margin: 0 0.2rem 0 0.15rem;
    padding: 0;
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.75rem;
    text-transform: uppercase;
  }

  .extras-toggle input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .extras-toggle label {
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
    gap: 0.35rem;
