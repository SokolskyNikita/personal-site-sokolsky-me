  <body>
    <main class="page">
      <header class="page-header">
        <a class="home-link" href="/">Nikita Sokolsky</a>
        <div class="headline">
          <p class="eyebrow">Buenos Aires guide</p>
          <h1>{pageTitle}</h1>
          <p class="intro">
            Adult psychiatrists only. Depression first, ADHD second. English is
            irrelevant. Booking places sit under each name.
          </p>
        </div>
        <div class="toolbar" aria-label="Psychiatrist filters">
          <fieldset class="extras-toggle">
            <legend>Filter</legend>
            <input id="filter-accepts-medife" type="checkbox" autocomplete="off" />
            <label for="filter-accepts-medife"
              >Accepts Medifé ({acceptsMedifeCount})</label
            >
          </fieldset>
          <p class="meta" id="list-status">
            Updated {updatedDate}. {doctors.length} psychiatrists.
          </p>
        </div>
      </header>

      <section class="clinic-list" aria-label="Ranked psychiatrists">
        {
          doctors.map((doctor) => (
            <article
              class="clinic"
              data-accepts-medife={String(doctor.medifeStatus === "yes")}
            >
              <header class="clinic-head">
                <p class="clinic-rank" aria-label={`Rank ${doctor.rank}`}>
                  {doctor.rank}
                </p>
                <div class="clinic-id">
                  <h2 class="clinic-name">
                    <a
                      href={doctor.url}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {doctor.name}
                    </a>
                    {doctor.kind === "independent" && (
                      <span class="clinic-kind">{kindLabel[doctor.kind]}</span>
                    )}
                  </h2>
                  <p class="clinic-service">{doctor.role}</p>
                </div>
                <p
                  class:list={[
                    "medife",
                    doctor.medifeStatus === "yes" && "medife-yes",
                    doctor.medifeStatus === "verify" && "medife-verify",
                    doctor.medifeStatus === "private" && "medife-private",
                  ]}
                >
                  {doctor.medifeLabel}
                </p>
                <p class="clinic-notes">{doctor.notes}</p>
              </header>

              <ul class="practice-list clinic-practices">
                {doctor.places.map((place) => (
                  <li class="practice">
                    <p class="practice-head">
                      {place.url ? (
                        <a
                          class="practice-name"
                          href={place.url}
                          target="_blank"
                          rel="noreferrer noopener"
                        >
                          {place.name}
                        </a>
                      ) : (
                        <span class="practice-name">{place.name}</span>
                      )}
                      {place.links && place.links.length > 0 && (
                        <span class="inline-links">
                          {place.links.map((link, index) => (
                            <>
                              <span class="sep"> · </span>
                              <a
                                href={link.href}
                                target="_blank"
                                rel="noreferrer noopener"
                              >
                                {link.label}
                              </a>
                            </>
                          ))}
                        </span>
                      )}
                    </p>
                    <p class="practice-meta">{place.address}</p>
                    {place.note && <p class="practice-note">{place.note}</p>}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>

<script is:inline>
  const medifeFilter = document.querySelector("#filter-accepts-medife");
  const listStatus = document.querySelector("#list-status");
  const clinicRows = [...document.querySelectorAll(".clinic")];
  const totalCount = clinicRows.length;

  const hasEnabledUrlParam = (params, key) => {
    const value = params.get(key);
    return value === "1" || value === "true" || value === "yes";
  };

  const updateFilterUrl = (acceptsMedifeOnly) => {
    const url = new URL(window.location.href);
    url.searchParams.delete("medife");
    if (acceptsMedifeOnly) url.searchParams.set("medife", "1");

    const nextUrl = `${url.pathname}${url.search}${url.hash}`;
    const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (nextUrl !== currentUrl) {
      window.history.replaceState(null, "", nextUrl);
    }
  };

  const applyFilters = ({ syncUrl = true } = {}) => {
    const acceptsMedifeOnly = Boolean(medifeFilter?.checked);
    let visibleCount = 0;

    for (const row of clinicRows) {
      const accepts = row.dataset.acceptsMedife === "true";
      const visible = !acceptsMedifeOnly || accepts;
      row.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    if (listStatus) {
      listStatus.textContent = acceptsMedifeOnly
        ? `Showing ${visibleCount} psychiatrist${visibleCount === 1 ? "" : "s"} who accept Medifé.`
        : `Showing all ${totalCount} psychiatrists.`;
    }

    if (syncUrl) updateFilterUrl(acceptsMedifeOnly);
  };

  const applyFiltersFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    if (medifeFilter) {
      medifeFilter.checked = hasEnabledUrlParam(params, "medife");
    }
    applyFilters({ syncUrl: false });
  };

  medifeFilter?.addEventListener("change", () => applyFilters());
  applyFiltersFromUrl();
  window.addEventListener("pageshow", applyFiltersFromUrl);
  window.addEventListener("popstate", applyFiltersFromUrl);
</script>

