---
import pageData from "../../data/ba-ophthalmologists.json";

export const prerender = true;

const pageTitle = pageData.title;
const pageDescription =
  "Ranked Buenos Aires ophthalmologists and eye clinics for a refraction, new glasses prescription, and daily disposable contacts, with Medifé and English notes.";
const themeColorLight = "#fcfaf7";
const themeColorDark = "#111111";
const siteUrl =
  (Astro.site?.toString() ?? "https://sokolsky.me").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const updatedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date(pageData.generatedAt));

type Place = (typeof pageData.places)[number];
type Optica = typeof pageData.optica;

const places = pageData.places;
const optica = pageData.optica;
const acceptsMedifeCount = places.filter((place) => place.medife.status === "yes").length;
const englishCount = places.filter((place) => place.english.speaks).length;
const contactsCount = places.filter((place) => place.contactLensFitting).length;

const kindLabel: Record<Place["kind"], string> = {
  hospital: "Hospital",
  clinic: "Clinic",
  doctor: "Doctor",
};

const glassesContactsLabel = (place: Place | Optica) => {
  const glasses = place.glassesRxSameDay
    ? "Same-day glasses Rx"
    : place.doesRefraction
      ? "Refraction, Rx not same-day"
      : "Not a refraction clinic";
  const contacts =
    place.dailyDisposables === "yes"
      ? "Daily disposables in stock"
      : place.contactLensFitting
        ? place.dailyDisposables === "likely"
          ? "Contact fitting; dailies likely"
          : "Contact fitting; confirm dailies"
        : "No contact fitting found";
  return { glasses, contacts };
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  numberOfItems: places.length,
  itemListElement: places.map((place) => ({
    "@type": "ListItem",
    position: place.rank,
    item: {
      "@type": place.kind === "hospital" ? "Hospital" : "Physician",
      name: place.name,
      url: place.url,
      medicalSpecialty: "Ophthalmology",
      description: place.bestFor,
      address: place.address,
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="subject" content="Best ophthalmologists in Buenos Aires" />
    <meta name="application-name" content={pageTitle} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="keywords"
      content="ophthalmologist Buenos Aires, oftalmólogo Buenos Aires, glasses prescription Buenos Aires, daily contact lenses Buenos Aires, Medifé ophthalmologist"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={themeColorLight} />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="msapplication-TileColor" content={themeColorDark} />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color={themeColorDark} />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Nikita Sokolsky" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <main class="page">
      <header class="page-header">
        <a class="home-link" href="/">Nikita Sokolsky</a>
        <div class="headline">
          <p class="eyebrow">Buenos Aires guide</p>
          <h1>{pageTitle}</h1>
          <p class="intro">
            Ranked for a refraction, a new glasses prescription, and daily
            disposable contacts. In Buenos Aires an oftalmólogo writes the
            receta; an óptica usually cuts the lenses and fits dailies. Hospital
            Italiano is the rare one-stop. Confirm Medifé and English before you
            book.
          </p>
        </div>
        <div class="toolbar" aria-label="Ophthalmologist filters">
          <fieldset class="extras-toggle">
            <legend>Filter</legend>
            <input id="filter-accepts-medife" type="checkbox" autocomplete="off" />
            <label for="filter-accepts-medife"
              >Accepts Medifé ({acceptsMedifeCount})</label
            >
            <input id="filter-english" type="checkbox" autocomplete="off" />
            <label for="filter-english">English ({englishCount})</label>
            <input id="filter-contacts" type="checkbox" autocomplete="off" />
            <label for="filter-contacts">Contact fitting ({contactsCount})</label>
          </fieldset>
          <div class="meta">
            <span>Updated {updatedDate}</span>
            <span aria-hidden="true">·</span>
            <span id="list-status">Showing all {places.length} providers.</span>
          </div>
        </div>
      </header>

      <aside class="optica-card" aria-label="Recommended óptica for daily contacts">
        <div class="optica-summary">
          <p class="optica-kicker">{optica.rankLabel}</p>
          <div class="optica-head">
            <h2>
              <a href={optica.url} target="_blank" rel="noreferrer noopener">
                {optica.name}
              </a>
            </h2>
            <p class="optica-place">{optica.address}</p>
          </div>
          <p class="optica-lead">{optica.bookingLead}</p>
        </div>
        <div class="optica-details">
          <p class="booking-links">
            {
              optica.bookingLinks.map((link, index) => (
                <>
                  {index > 0 && <span class="booking-sep"> · </span>}
                  <a href={link.href} target="_blank" rel="noreferrer noopener">
                    {link.label}
                  </a>
                </>
              ))
            }
          </p>
          <p class="optica-notes">{optica.notes}</p>
        </div>
      </aside>

      <section class="doctor-list" aria-label="Buenos Aires ophthalmologists">
        <div class="doctor-row doctor-head" aria-hidden="true">
          <span>Rank</span>
          <span>Clinic</span>
          <span>How to book</span>
          <span>Glasses and contacts</span>
          <span>Notes</span>
          <span>Medifé</span>
        </div>

        {
          places.map((place) => {
            const labels = glassesContactsLabel(place);
            return (
              <article
                class="doctor-row"
                data-accepts-medife={String(place.medife.status === "yes")}
                data-english={String(place.english.speaks)}
                data-contacts={String(place.contactLensFitting)}
              >
                <p class="rank" aria-label={`Rank ${place.rank}`}>
                  {place.rank}
                </p>
                <div class="doctor-name-block">
                  <h2 class="doctor-name">
                    <a href={place.url} target="_blank" rel="noreferrer noopener">
                      {place.name}
                    </a>
                  </h2>
                  <p class="place-meta">
                    {kindLabel[place.kind]} · {place.neighborhood}
                  </p>
                </div>
                <div class="booking">
                  <p class="booking-lead">{place.bookingLead}</p>
                  {
                    place.bookingLinks.length > 0 && (
                      <p class="booking-links">
                        {place.bookingLinks.map((link, index) => (
                          <>
                            {index > 0 && <span class="booking-sep"> · </span>}
                            <a
                              href={link.href}
                              target="_blank"
                              rel="noreferrer noopener"
                            >
                              {link.label}
                            </a>
                          </>
                        ))}
                      </p>
                    )
                  }
                </div>
                <div class="fit">
                  <p>{labels.glasses}</p>
                  <p>{labels.contacts}</p>
                  {
                    place.english.speaks && (
                      <p class="english-note">{place.english.label}</p>
                    )
                  }
                </div>
                <div class="notes">
                  <p>{place.bestFor}</p>
                  {place.caution && <p class="caution">{place.caution}</p>}
                </div>
                <p
                  class:list={[
                    "medife",
                    place.medife.status === "yes" && "medife-yes",
                    place.medife.status === "verify" && "medife-verify",
                    place.medife.status === "private" && "medife-private",
                  ]}
                >
                  {place.medife.label}
                </p>
              </article>
            );
          })
        }
      </section>
    </main>
  </body>
</html>

<script is:inline>
  const medifeFilter = document.querySelector("#filter-accepts-medife");
  const englishFilter = document.querySelector("#filter-english");
  const contactsFilter = document.querySelector("#filter-contacts");
  const listStatus = document.querySelector("#list-status");
  const doctorRows = [...document.querySelectorAll(".doctor-row:not(.doctor-head)")];
  const totalCount = doctorRows.length;

  const hasEnabledUrlParam = (params, key) => {
    const value = params.get(key);
    return value === "1" || value === "true" || value === "yes";
  };

  const updateFilterUrl = (filters) => {
    const url = new URL(window.location.href);
    for (const key of ["medife", "english", "contacts"]) {
      url.searchParams.delete(key);
    }
    if (filters.medife) url.searchParams.set("medife", "1");
    if (filters.english) url.searchParams.set("english", "1");
    if (filters.contacts) url.searchParams.set("contacts", "1");

    const nextUrl = `${url.pathname}${url.search}${url.hash}`;
    const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (nextUrl !== currentUrl) {
      window.history.replaceState(null, "", nextUrl);
    }
  };

  const applyFilters = ({ syncUrl = true } = {}) => {
    const filters = {
      medife: Boolean(medifeFilter?.checked),
      english: Boolean(englishFilter?.checked),
      contacts: Boolean(contactsFilter?.checked),
    };
    let visibleCount = 0;

    for (const row of doctorRows) {
      const matchesMedife = !filters.medife || row.dataset.acceptsMedife === "true";
      const matchesEnglish = !filters.english || row.dataset.english === "true";
      const matchesContacts = !filters.contacts || row.dataset.contacts === "true";
      const visible = matchesMedife && matchesEnglish && matchesContacts;
      row.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    if (listStatus) {
      const parts = [];
      if (filters.medife) parts.push("Medifé");
      if (filters.english) parts.push("English");
      if (filters.contacts) parts.push("contact fitting");
      listStatus.textContent = parts.length
              ? `Showing ${visibleCount} provider${visibleCount === 1 ? "" : "s"} with ${parts.join(", ")}.`
              : `Showing all ${totalCount} providers.`;
    }

    if (syncUrl) updateFilterUrl(filters);
  };

  const applyFiltersFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    if (medifeFilter) medifeFilter.checked = hasEnabledUrlParam(params, "medife");
    if (englishFilter) englishFilter.checked = hasEnabledUrlParam(params, "english");
    if (contactsFilter) contactsFilter.checked = hasEnabledUrlParam(params, "contacts");
    applyFilters({ syncUrl: false });
  };

  medifeFilter?.addEventListener("change", () => applyFilters());
  englishFilter?.addEventListener("change", () => applyFilters());
  contactsFilter?.addEventListener("change", () => applyFilters());
  applyFiltersFromUrl();
  window.addEventListener("pageshow", applyFiltersFromUrl);
  window.addEventListener("popstate", applyFiltersFromUrl);
</script>

<style>
  :root {
    color-scheme: light dark;
    --bg: #fcfaf7;
    --surface: #fffdf8;
    --surface-soft: #efe7db;
    --text: #181612;
    --text-muted: #6f675c;
    --border: #d9cfc0;
    --border-strong: #c8baa8;
    --accent: #28402f;
    --accent-soft: #dfe8d7;
    --link: #17281d;
    --shadow: 0 20px 60px rgba(61, 44, 22, 0.08);
    --yes: #2f5d3a;
    --yes-soft: #dcead9;
    --verify: #8a6a2f;
    --verify-soft: #f3e7c8;
    --private: #6f675c;
    --private-soft: #ebe4d8;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #10100e;
      --surface: #171613;
      --surface-soft: #211f1a;
      --text: #f2eee7;
      --text-muted: #aaa297;
      --border: #343027;
      --border-strong: #4a4338;
      --accent: #dce8d2;
      --accent-soft: #263022;
      --link: #f6f1e8;
      --shadow: none;
      --yes: #b7d4b8;
      --yes-soft: #243126;
      --verify: #e2c788;
      --verify-soft: #332914;
      --private: #aaa297;
      --private-soft: #26231e;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
    font-size: 16px;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    margin: 0;
    background:
      radial-gradient(
        circle at 15% 0%,
        color-mix(in srgb, var(--accent-soft), transparent 35%),
        transparent 32rem
      ),
      var(--bg);
  }

  a {
    color: var(--link);
    text-decoration-color: color-mix(in srgb, var(--link), transparent 62%);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  .page {
    width: min(100%, 86rem);
    margin: 0 auto;
    padding:
      max(0.55rem, env(safe-area-inset-top))
      max(0.7rem, env(safe-area-inset-right))
      max(1.1rem, env(safe-area-inset-bottom))
      max(0.7rem, env(safe-area-inset-left));
  }

  .page-header {
    display: grid;
    gap: 0.4rem;
    align-items: start;
    padding: 0.1rem 0 0.35rem;
  }

  .home-link {
    width: fit-content;
    color: var(--text-muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .home-link:hover {
    color: var(--text);
  }

  .headline {
    display: grid;
    gap: 0.28rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .intro {
    margin: 0;
    max-width: 46rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
  }

  .extras-toggle {
    position: relative;
    display: flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0.28rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface), transparent 6%);
    box-shadow: var(--shadow);
  }

  .extras-toggle legend {
    margin: 0 0.2rem 0 0.15rem;
    padding: 0;
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.75rem;
    text-transform: uppercase;
  }

  .extras-toggle input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  .extras-toggle label {
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
    gap: 0.35rem;
    justify-content: center;
    border-radius: 999px;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0 0.6rem;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  .extras-toggle label::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    opacity: 0.75;
  }

  #filter-accepts-medife:checked ~ label[for="filter-accepts-medife"],
  #filter-english:checked ~ label[for="filter-english"],
  #filter-contacts:checked ~ label[for="filter-contacts"] {
    background: var(--accent);
    color: var(--bg);
  }

  #filter-accepts-medife:checked ~ label[for="filter-accepts-medife"]::before,
  #filter-english:checked ~ label[for="filter-english"]::before,
  #filter-contacts:checked ~ label[for="filter-contacts"]::before {
    background: currentColor;
    box-shadow: inset 0 0 0 3px var(--accent);
    opacity: 1;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3rem;
    margin: 0;
    flex-basis: 100%;
    max-width: 46rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    text-align: left;
  }

  .optica-card {
    display: grid;
    grid-template-columns: minmax(16rem, 0.9fr) minmax(24rem, 1.4fr);
    gap: 0.45rem 1rem;
    margin: 0 0 0.65rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--accent-soft), var(--surface) 55%);
    box-shadow: var(--shadow);
  }

  .optica-summary,
  .optica-details {
    display: grid;
    gap: 0.2rem;
    align-content: start;
    min-width: 0;
  }

  .optica-details {
    padding-left: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--border), transparent 20%);
  }

  .optica-kicker {
    margin: 0;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .optica-head h2 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .optica-head a {
    color: inherit;
  }

  .optica-place,
  .optica-lead,
  .optica-notes {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.35;
  }

  .doctor-list {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .doctor-row {
    display: grid;
    grid-template-columns:
      3.6rem
      minmax(11rem, 1.15fr)
      minmax(13rem, 1.35fr)
      minmax(10rem, 0.95fr)
      minmax(14rem, 1.5fr)
      minmax(8rem, 0.75fr);
    gap: 0;
    align-items: start;
    border-top: 1px solid var(--border);
  }

  .doctor-row[hidden] {
    display: none;
  }

  .doctor-head {
    align-items: center;
    border-top: 0;
    background: var(--surface-soft);
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .doctor-head > * {
    white-space: nowrap;
  }

  .doctor-row > * {
    min-width: 0;
    margin: 0;
    padding: 0.45rem 0.5rem;
    border-left: 1px solid var(--border);
    overflow-wrap: break-word;
    word-break: normal;
  }

  .doctor-row > *:first-child {
    border-left: 0;
  }

  .rank {
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .doctor-name {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .doctor-name a {
    color: inherit;
    text-decoration-thickness: 1px;
  }

  .place-meta {
    margin: 0.15rem 0 0;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .booking,
  .notes,
  .fit {
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .booking,
  .notes,
  .fit {
    display: grid;
    gap: 0.18rem;
    align-content: start;
  }

  .notes p,
  .caution {
    margin: 0;
  }

  .caution {
    color: color-mix(in srgb, var(--text-muted), var(--text) 18%);
  }

  .fit p,
  .booking-lead,
  .booking-links {
    margin: 0;
  }

  .english-note {
    color: var(--yes);
    font-weight: 650;
  }

  .booking-links a {
    font-weight: 700;
    color: var(--link);
    text-decoration-thickness: 1px;
  }

  .extras-toggle label:focus-visible,
  .booking-links a:focus-visible,
  .home-link:focus-visible,
  .doctor-name a:focus-visible,
  .optica-head a:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent), transparent 30%);
    outline-offset: 2px;
  }

  #filter-accepts-medife:focus-visible ~ label[for="filter-accepts-medife"],
  #filter-english:focus-visible ~ label[for="filter-english"],
