---
export const prerender = true;

const pageTitle = "Best BA surgeons";
const pageDescription =
  "Ranked Buenos Aires teams for venous thoracic outlet syndrome (Paget-Schroetter) requiring first rib resection, with Medifé coverage notes.";
const themeColorLight = "#fcfaf7";
const themeColorDark = "#111111";
const siteUrl =
  (Astro.site?.toString() ?? "https://sokolsky.me").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const updatedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date());

type MedifeStatus = "yes" | "verify" | "private";

type BookingLink = {
  label: string;
  href: string;
};

type SurgeonTeam = {
  rank: number;
  name: string;
  url: string;
  location: string;
  bookingLead: string;
  bookingLinks: BookingLink[];
  notes: string;
  medifeLabel: string;
  medifeStatus: MedifeStatus;
};

const teams: SurgeonTeam[] = [
  {
    rank: 1,
    name: "Hospital Británico — Cirugía Torácica (Buero, Olivera López, Lyons, Chimondeguy, Pankl)",
    url: "https://www.cirugiatoracicahb.com.ar/",
    location: "Hospital Británico Central, Perdriel 74, CABA",
    bookingLead:
      "Ask for Buero (venous lead): a_buero@hotmail.com. Central 0810-222-2748.",
    bookingLinks: [
      { label: "Service site", href: "https://www.cirugiatoracicahb.com.ar/equipo" },
      {
        label: "Turno online",
        href: "https://www.hbritanicoweb.com.ar/Customers/HospitalBritanico/Default",
      },
      {
        label: "2024 series",
        href: "https://pubmed.ncbi.nlm.nih.gov/39309754/",
      },
    ],
    notes:
      "Only Argentine published venous-TOS series (EJVES 2024: 32 VATS FRR, 31 venous). Buero first author; confirm hybrid venography plan.",
    medifeLabel: "Yes via Británico — confirm plan",
    medifeStatus: "yes",
  },
  {
    rank: 2,
    name: "Hospital Italiano — Cirugía Torácica (Smith, Dietrich, Raíces)",
    url: "https://www.cirugiageneralhiba.com.ar/cirugia-toracica/",
    location: "Perón 4190, CABA — Sector de Cirugía Torácica y Trasplante Pulmonar",
    bookingLead:
      "Secretary Cecilia Bertinat; (011) 4959-0200 int. 8341; WhatsApp +54 9 11 5752-9676.",
    bookingLinks: [
      {
        label: "Service page",
        href: "https://www.cirugiageneralhiba.com.ar/cirugia-toracica/",
      },
      {
        label: "WhatsApp",
        href: "https://wa.me/5491157529676",
      },
    ],
    notes:
      "Published venous pathway (thrombolysis → transaxillary FRR → venography/angioplasty). No TOS case count — ask volume.",
    medifeLabel: "Yes via Hospital Italiano — confirm plan (Oro+/Plata+)",
    medifeStatus: "yes",
  },
  {
    rank: 3,
    name: "Mariano Socolovsky — Cirugía de nervios periféricos",
    url: "https://socolovsky.com/",
    location:
      "Hospital de Clínicas (UBA); also Hospital Británico and Fundación Favaloro",
    bookingLead:
      "Medifé: CEMUVA Juncal 2280, (011) 4826-8513. Private Paraguay 2302 — particular.",
    bookingLinks: [
      { label: "Website", href: "https://socolovsky.com/" },
      { label: "Contacto", href: "https://socolovsky.com/contacto" },
    ],
    notes:
      "Leading Argentine neurogenic TOS surgeon (31-case series); zero venous cases — not primary for Paget-Schroetter.",
    medifeLabel: "Yes — cartilla at CEMUVA Juncal 2280; Paraguay office particular",
    medifeStatus: "yes",
  },
  {
    rank: 4,
    name: "Martín Francisco Parodi — Cirugía vascular (Finochietto / FLENI)",
    url: "https://www.doctoraliar.com/martin-francisco-parodi/cirujano-vascular/capital-federal",
    location:
      "Sanatorio Finochietto (Jefe de Cirugía Vascular); FLENI Belgrano",
    bookingLead:
      "Finochietto turnos / WhatsApp; Doctoralia for private consultorio (M.T. de Alvear 2320).",
    bookingLinks: [
      {
        label: "Doctoralia",
        href: "https://www.doctoraliar.com/martin-francisco-parodi/cirujano-vascular/capital-federal",
      },
      {
        label: "Finochietto turnos",
        href: "https://turnos.sanatoriofinochietto.com/",
      },
      {
        label: "FLENI vascular",
        href: "https://www.fleni.org.ar/especialidades/otras-especialidades/servicio-de-flebologia-y-cirugia-vascular/",
      },
    ],
    notes:
      "Finochietto vascular chief; FLENI lists opérculo torácico. 2023 congress talk on opérculo; no published venous-TOS/FRR series — ask volume.",
    medifeLabel: "Yes via Finochietto — confirm plan",
    medifeStatus: "yes",
  },
  {
    rank: 5,
    name: "Fundación Favaloro — Flebolinfología / hybrid (Gural Romero)",
    url: "https://www.fundacionfavaloro.org/flebolinfologia/",
    location: "Av. Belgrano 1746, CABA; Gural also Vascular Integral (private)",
    bookingLead:
      "Favaloro central (011) 4378-1200 — flebolinfología. Gural private WhatsApp +54 9 11 6703-3505.",
    bookingLinks: [
      {
        label: "Flebolinfología",
        href: "https://www.fundacionfavaloro.org/flebolinfologia/",
      },
      {
        label: "Portal turnos",
        href: "https://portalweb.fundacionfavaloro.org/",
      },
      {
        label: "Gural (TopDoctors)",
        href: "https://www.topdoctors.com.ar/doctor/oscar-gural-romero/",
      },
    ],
    notes:
      "Hybrid CV center; Gural Romero does venous opérculo endovascularly, not FRR. Ask about stenting before decompression.",
    medifeLabel: "Verify — Favaloro in cartilla; Gural private-only",
    medifeStatus: "verify",
  },
  {
    rank: 6,
    name: "Private / other hybrid services (grouped)",
    url: "https://www.hospitalaustral.edu.ar/servicios-medicos/cirugia-toracica/",
    location:
      "Hospital Universitario Austral, Sanatorio Güemes, CEMIC, Hospital Alemán, ICBA",
    bookingLead:
      "Book via each institution’s thoracic or vascular desk; ask named operator + volume.",
    bookingLinks: [
      {
        label: "Austral torácica",
        href: "https://www.hospitalaustral.edu.ar/servicios-medicos/cirugia-toracica/",
      },
      {
        label: "Güemes",
        href: "https://sitio.sg.com.ar/",
      },
      {
        label: "Alemán torácica",
        href: "https://www.hospitalaleman.org.ar/nuestro-hospital/servicios-medicos/cirugia-toracica/",
      },
      {
        label: "ICBA",
        href: "https://www.icba.com.ar/",
      },
    ],
    notes:
      "Austral/Güemes/Alemán/ICBA list TOS capability; no published venous volume. Ask named operator and outcomes.",
    medifeLabel: "Verify — plan and site dependent",
    medifeStatus: "verify",
  },
];

const acceptsMedifeCount = teams.filter(
  (team) => team.medifeStatus === "yes",
).length;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  numberOfItems: teams.length,
  itemListElement: teams.map((team) => ({
    "@type": "ListItem",
    position: team.rank,
    item: {
      "@type": "Physician",
      name: team.name,
      url: team.url,
      medicalSpecialty: "Thoracic Surgery",
      description: team.notes,
      address: team.location,
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="subject"
      content="Best BA surgeons"
    />
    <meta name="application-name" content={pageTitle} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="keywords"
      content="venous TOS Buenos Aires, Paget-Schroetter surgeon Buenos Aires, first rib resection Buenos Aires, opérculo torácico cirujano, Hospital Británico Buero, thoracic outlet syndrome Argentina"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={themeColorLight} />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="msapplication-TileColor" content={themeColorDark} />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color={themeColorDark} />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Nikita Sokolsky" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <main class="page">
      <header class="page-header">
        <a class="home-link" href="/">Nikita Sokolsky</a>
        <div class="headline">
          <p class="eyebrow">Buenos Aires guide</p>
          <h1>{pageTitle}</h1>
          <p class="intro">
            Ranked by published venous-TOS evidence and hybrid capability.
            Medifé coverage varies by plan and address — confirm before booking.
          </p>
        </div>
        <div class="toolbar" aria-label="Surgeon filters">
          <fieldset class="extras-toggle">
            <legend>Filter</legend>
            <input id="filter-accepts-medife" type="checkbox" autocomplete="off" />
            <label for="filter-accepts-medife"
              >Accepts Medifé ({acceptsMedifeCount})</label
            >
          </fieldset>
          <p class="meta" id="list-status">
            Updated {updatedDate}. Showing all {teams.length} options.
          </p>
        </div>
      </header>

      <section class="doctor-list" aria-label="Best BA surgeons">
        <div class="doctor-row doctor-head" aria-hidden="true">
          <span>Rank</span>
          <span>Team</span>
          <span>How to book</span>
          <span>Notes</span>
          <span>Medifé</span>
        </div>

        {
          teams.map((team) => (
            <article
              class="doctor-row"
              data-accepts-medife={String(team.medifeStatus === "yes")}
            >
              <p class="rank" aria-label={`Rank ${team.rank}`}>
                {team.rank}
              </p>
              <h2 class="doctor-name">
                <a href={team.url} target="_blank" rel="noreferrer noopener">
                  {team.name}
                </a>
              </h2>
              <div class="booking">
                <p class="booking-lead">{team.bookingLead}</p>
                {
                  team.bookingLinks.length > 0 && (
                    <p class="booking-links">
                      {team.bookingLinks.map((link, index) => (
                        <>
                          {index > 0 && <span class="booking-sep"> · </span>}
                          <a
                            href={link.href}
                            target="_blank"
                            rel="noreferrer noopener"
                          >
                            {link.label}
                          </a>
                        </>
                      ))}
                    </p>
                  )
                }
              </div>
              <p class="notes">{team.notes}</p>
              <p
                class:list={[
                  "medife",
                  team.medifeStatus === "yes" && "medife-yes",
                  team.medifeStatus === "verify" && "medife-verify",
                  team.medifeStatus === "private" && "medife-private",
                ]}
              >
                {team.medifeLabel}
              </p>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>

<script is:inline>
  const medifeFilter = document.querySelector("#filter-accepts-medife");
  const listStatus = document.querySelector("#list-status");
  const doctorRows = [...document.querySelectorAll(".doctor-row:not(.doctor-head)")];
  const totalCount = doctorRows.length;

  const hasEnabledUrlParam = (params, key) => {
    const value = params.get(key);
    return value === "1" || value === "true" || value === "yes";
  };

  const updateFilterUrl = (acceptsMedifeOnly) => {
    const url = new URL(window.location.href);
    url.searchParams.delete("medife");
    if (acceptsMedifeOnly) url.searchParams.set("medife", "1");

    const nextUrl = `${url.pathname}${url.search}${url.hash}`;
    const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (nextUrl !== currentUrl) {
      window.history.replaceState(null, "", nextUrl);
    }
  };

  const applyFilters = ({ syncUrl = true } = {}) => {
    const acceptsMedifeOnly = Boolean(medifeFilter?.checked);
    let visibleCount = 0;

    for (const row of doctorRows) {
      const accepts = row.dataset.acceptsMedife === "true";
      const visible = !acceptsMedifeOnly || accepts;
      row.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    if (listStatus) {
      listStatus.textContent = acceptsMedifeOnly
        ? `Showing ${visibleCount} option${visibleCount === 1 ? "" : "s"} who accept Medifé.`
        : `Showing all ${totalCount} options.`;
    }

    if (syncUrl) updateFilterUrl(acceptsMedifeOnly);
  };

  const applyFiltersFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    if (medifeFilter) {
      medifeFilter.checked = hasEnabledUrlParam(params, "medife");
    }
    applyFilters({ syncUrl: false });
  };

  medifeFilter?.addEventListener("change", () => applyFilters());
  applyFiltersFromUrl();
  window.addEventListener("pageshow", applyFiltersFromUrl);
  window.addEventListener("popstate", applyFiltersFromUrl);
</script>

<style>
  :root {
    color-scheme: light dark;
    --bg: #fcfaf7;
    --surface: #fffdf8;
    --surface-soft: #efe7db;
    --text: #181612;
    --text-muted: #6f675c;
    --border: #d9cfc0;
    --border-strong: #c8baa8;
    --accent: #28402f;
    --accent-soft: #dfe8d7;
    --link: #17281d;
    --shadow: 0 20px 60px rgba(61, 44, 22, 0.08);
    --yes: #2f5d3a;
    --yes-soft: #dcead9;
    --verify: #8a6a2f;
    --verify-soft: #f3e7c8;
    --private: #6f675c;
    --private-soft: #ebe4d8;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #10100e;
      --surface: #171613;
      --surface-soft: #211f1a;
      --text: #f2eee7;
      --text-muted: #aaa297;
      --border: #343027;
      --border-strong: #4a4338;
      --accent: #dce8d2;
      --accent-soft: #263022;
      --link: #f6f1e8;
      --shadow: none;
      --yes: #b7d4b8;
      --yes-soft: #243126;
      --verify: #e2c788;
      --verify-soft: #332914;
      --private: #aaa297;
      --private-soft: #26231e;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
    font-size: 16px;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    margin: 0;
    background:
      radial-gradient(
        circle at 15% 0%,
        color-mix(in srgb, var(--accent-soft), transparent 35%),
        transparent 32rem
      ),
      var(--bg);
  }

  a {
    color: var(--link);
    text-decoration-color: color-mix(in srgb, var(--link), transparent 62%);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  .page {
    width: min(100%, 72rem);
    margin: 0 auto;
    padding: 0.75rem clamp(0.7rem, 1.6vw, 1.25rem) 1.25rem;
  }

  .page-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.55rem;
    align-items: start;
    padding: 0.35rem 0 0.65rem;
  }

  .home-link {
    width: fit-content;
    color: var(--text-muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .home-link:hover {
    color: var(--text);
  }

  .headline {
    display: grid;
    gap: 0.28rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .intro {
    margin: 0;
    max-width: 42rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
  }

  .extras-toggle {
    display: flex;
    width: fit-content;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0.28rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface), transparent 6%);
    box-shadow: var(--shadow);
  }

  .extras-toggle legend {
    margin: 0 0.2rem 0 0.15rem;
    padding: 0;
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.75rem;
    text-transform: uppercase;
  }

  .extras-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .extras-toggle label {
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
    gap: 0.35rem;
    justify-content: center;
    border-radius: 999px;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0 0.6rem;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  .extras-toggle label::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    opacity: 0.75;
  }

  #filter-accepts-medife:checked ~ label[for="filter-accepts-medife"] {
    background: var(--accent);
    color: var(--bg);
  }

  #filter-accepts-medife:checked ~ label[for="filter-accepts-medife"]::before {
    background: currentColor;
    box-shadow: inset 0 0 0 3px var(--accent);
    opacity: 1;
  }

  .meta {
    margin: 0;
    flex-basis: 100%;
    max-width: 42rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    text-align: left;
  }

  .doctor-list {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .doctor-row {
    display: grid;
    grid-template-columns:
      3.4rem
      minmax(8.5rem, 1.05fr)
      minmax(9.5rem, 1.2fr)
      minmax(13rem, 1.7fr)
      minmax(9.5rem, 1.15fr);
    gap: 0;
    align-items: stretch;
    border-top: 1px solid var(--border);
  }

  .doctor-row[hidden] {
    display: none;
  }

  .doctor-head {
    border-top: 0;
    background: var(--surface-soft);
    color: var(--text-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .doctor-row > * {
    min-width: 0;
    margin: 0;
    padding: 0.5rem 0.55rem;
    border-left: 1px solid var(--border);
    overflow-wrap: anywhere;
  }

  .doctor-row > *:first-child {
    border-left: 0;
  }

  .rank {
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .doctor-name {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .doctor-name a {
    color: inherit;
    text-decoration-thickness: 1px;
  }

  .booking,
  .notes {
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.35;
  }

  .booking {
    display: grid;
    gap: 0.2rem;
  }

  .booking-lead,
  .booking-links {
    margin: 0;
  }

  .booking-links a {
    font-weight: 700;
    color: var(--link);
    text-decoration-thickness: 1px;
  }

  .booking-sep {
    color: var(--text-muted);
    font-weight: 500;
  }

  .medife {
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .medife-yes {
    color: var(--yes);
  }

  .medife-verify {
    color: var(--verify);
  }

  .medife-private {
    color: var(--private);
  }

  @media (max-width: 900px) {
    .page {
      padding: 0.55rem 0.6rem 1rem;
    }

    .page-header {
      padding: 0.15rem 0 0.5rem;
      gap: 0.45rem;
    }

    h1 {
      font-size: 1.35rem;
      line-height: 1.15;
    }

    .intro {
      font-size: 0.86rem;
      line-height: 1.38;
    }

    .doctor-list {
      border-radius: 0.9rem;
      background: transparent;
      border-color: var(--border-strong);
    }

    .doctor-head {
