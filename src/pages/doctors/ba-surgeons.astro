---
export const prerender = true;

const pageTitle = "Best BA surgeons";
const pageDescription =
  "Ranked Buenos Aires clinics, then surgeons, for venous thoracic outlet syndrome (Paget-Schroetter) requiring first rib resection, with private-consultorio and Medifé notes.";
const themeColorLight = "#fcfaf7";
const themeColorDark = "#111111";
const siteUrl =
  (Astro.site?.toString() ?? "https://sokolsky.me").replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const updatedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date());

type MedifeStatus = "yes" | "verify" | "private";
type ClinicKind = "hospital" | "independent" | "group";

type BookingLink = {
  label: string;
  href: string;
};

type PrivatePractice = {
  name: string;
  url?: string;
  address: string;
  note?: string;
};

type Surgeon = {
  rank: number;
  name: string;
  role: string;
  practices: PrivatePractice[];
  noneNote?: string;
};

type Clinic = {
  rank: number;
  kind: ClinicKind;
  name: string;
  nameLinks?: BookingLink[];
  service: string;
  url: string;
  location: string;
  bookingLead: string;
  bookingLinks: BookingLink[];
  notes: string;
  medifeLabel: string;
  medifeStatus: MedifeStatus;
  practices?: PrivatePractice[];
  surgeons: Surgeon[];
};

const clinicSurgeonCount = (clinic: Clinic) =>
  clinic.kind === "independent" ? 1 : clinic.surgeons.length;

const kindLabel: Record<ClinicKind, string> = {
  hospital: "Hospital / clinic",
  independent: "Independent",
  group: "Other clinics",
};

const clinics: Clinic[] = [
  {
    rank: 1,
    kind: "hospital",
    name: "Hospital Británico",
    service: "Cirugía Torácica",
    url: "https://www.hospitalbritanico.org.ar/",
    location: "Hospital Británico Central, Perdriel 74, CABA",
    bookingLead: "Ask for Buero (venous lead).",
    bookingLinks: [
      { label: "Cirugía Torácica", href: "https://www.cirugiatoracicahb.com.ar/" },
      { label: "2024 series", href: "https://pubmed.ncbi.nlm.nih.gov/39309754/" },
    ],
    notes:
      "Only Argentine published venous-TOS series (EJVES 2024: 32 VATS FRR, 31 venous). Buero first author; ask about hybrid venography.",
    medifeLabel: "Yes via Británico",
    medifeStatus: "yes",
    surgeons: [
      {
        rank: 1,
        name: "Agustín Buero",
