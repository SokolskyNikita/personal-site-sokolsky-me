const acceptsMedifeCount = clinics.filter(
  (clinic) => clinic.medifeStatus === "yes",
).length;
const surgeonCount = clinics.reduce(
  (count, clinic) => count + clinicSurgeonCount(clinic),
  0,
);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  numberOfItems: clinics.length,
  itemListElement: clinics.map((clinic) => ({
    "@type": "ListItem",
    position: clinic.rank,
    item: {
      "@type": clinic.kind === "independent" ? "Physician" : "Hospital",
      name: clinic.name,
      url: clinic.url,
      description: clinic.notes,
      address: clinic.location,
      employee: clinic.surgeons.map((surgeon) => ({
        "@type": "Physician",
        name: surgeon.name,
        description: surgeon.role,
      })),
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="subject" content="Best BA surgeons" />
    <meta name="application-name" content={pageTitle} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta
      name="keywords"
      content="venous TOS Buenos Aires, Paget-Schroetter surgeon Buenos Aires, first rib resection Buenos Aires, opérculo torácico cirujano, Hospital Británico Buero, ICBA cirugía vascular, thoracic outlet syndrome Argentina"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={themeColorLight} />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="msapplication-TileColor" content={themeColorDark} />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color={themeColorDark} />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Nikita Sokolsky" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <main class="page">
      <header class="page-header">
        <a class="home-link" href="/">Nikita Sokolsky</a>
        <div class="headline">
          <p class="eyebrow">Buenos Aires guide</p>
          <h1>{pageTitle}</h1>
          <p class="intro">
            Clinics first, then surgeons inside each clinic. Private consultorios
            sit under each doctor — usually the faster booking path. Ranked by
            published venous-TOS / first-rib evidence, then hybrid capability.
          </p>
        </div>
        <div class="toolbar" aria-label="Surgeon filters">
          <fieldset class="extras-toggle">
            <legend>Filter</legend>
            <input id="filter-accepts-medife" type="checkbox" autocomplete="off" />
            <label for="filter-accepts-medife"
              >Accepts Medifé ({acceptsMedifeCount})</label
            >
          </fieldset>
          <p class="meta" id="list-status">
            Updated {updatedDate}. {clinics.length} clinics · {surgeonCount} surgeons.
          </p>
        </div>
      </header>

      <section class="clinic-list" aria-label="Ranked clinics and surgeons">
        {
          clinics.map((clinic) => (
            <article
              class="clinic"
              data-accepts-medife={String(clinic.medifeStatus === "yes")}
              data-surgeon-count={String(clinicSurgeonCount(clinic))}
            >
              <header class="clinic-head">
                <p class="clinic-rank" aria-label={`Clinic rank ${clinic.rank}`}>
                  {clinic.rank}
                </p>
                <div class="clinic-id">
                  <h2 class="clinic-name">
                    {clinic.nameLinks?.length ? (
                      clinic.nameLinks.map((part) => (
                        <a
                          href={part.href}
                          target="_blank"
                          rel="noreferrer noopener"
                        >
                          {part.label}
                        </a>
                      ))
                    ) : (
                      <a
                        href={clinic.url}
                        target="_blank"
                        rel="noreferrer noopener"
                      >
                        {clinic.name}
                      </a>
                    )}
                    {clinic.kind !== "hospital" && (
                      <span class="clinic-kind">{kindLabel[clinic.kind]}</span>
                    )}
                  </h2>
                  <p class="clinic-service">
                    {clinic.service}
                    <span class="clinic-loc">{clinic.location}</span>
                  </p>
                </div>
                <p
                  class:list={[
                    "medife",
                    clinic.medifeStatus === "yes" && "medife-yes",
                    clinic.medifeStatus === "verify" && "medife-verify",
                    clinic.medifeStatus === "private" && "medife-private",
                  ]}
                >
                  {clinic.medifeLabel}
                </p>
                {(clinic.bookingLead || clinic.bookingLinks.length > 0) && (
                  <p class="clinic-book">
                    {clinic.bookingLead}
                    {clinic.bookingLinks.length > 0 && (
                      <span class="inline-links">
                        {clinic.bookingLead && <span class="sep"> </span>}
                        {clinic.bookingLinks.map((link, index) => (
                          <>
                            {index > 0 && <span class="sep"> · </span>}
                            <a
                              href={link.href}
                              target="_blank"
                              rel="noreferrer noopener"
                            >
                              {link.label}
                            </a>
                          </>
                        ))}
                      </span>
                    )}
                  </p>
                )}
                <p class="clinic-notes">{clinic.notes}</p>
              </header>

              {clinic.kind === "independent" &&
              (clinic.practices?.length ?? 0) > 0 ? (
                <ul class="practice-list clinic-practices">
                  {clinic.practices!.map((practice) => (
                    <li class="practice">
                      <p class="practice-head">
                        {practice.url ? (
                          <a
                            class="practice-name"
                            href={practice.url}
                            target="_blank"
                            rel="noreferrer noopener"
                          >
                            {practice.name}
                          </a>
                        ) : (
                          <span class="practice-name">{practice.name}</span>
                        )}
                      </p>
                      <p class="practice-meta">{practice.address}</p>
                      {practice.note && (
                        <p class="practice-note">{practice.note}</p>
                      )}
                    </li>
                  ))}
                </ul>
              ) : clinic.surgeons.length > 0 ? (
                <ol class="surgeon-list">
                  {clinic.surgeons
                    .slice()
                    .sort((a, b) => a.rank - b.rank)
                    .map((surgeon) => (
                      <li class="surgeon">
                        <p
                          class="surgeon-rank"
                          aria-label={`Surgeon rank ${clinic.rank}.${surgeon.rank}`}
                        >
                          {clinic.rank}.{surgeon.rank}
                        </p>
                        <div class="surgeon-body">
                          <h3 class="surgeon-name">
                            {surgeon.name}
                            <span class="surgeon-role"> · {surgeon.role}</span>
                          </h3>
                          {surgeon.practices.length > 0 ? (
                            <ul class="practice-list">
                              {surgeon.practices.map((practice) => (
                                <li class="practice">
                                  <p class="practice-head">
                                    {practice.url ? (
                                      <a
                                        class="practice-name"
                                        href={practice.url}
                                        target="_blank"
                                        rel="noreferrer noopener"
                                      >
                                        {practice.name}
                                      </a>
                                    ) : (
                                      <span class="practice-name">
                                        {practice.name}
                                      </span>
                                    )}
                                  </p>
                                  <p class="practice-meta">{practice.address}</p>
                                  {practice.note && (
                                    <p class="practice-note">{practice.note}</p>
                                  )}
                                </li>
                              ))}
                            </ul>
                          ) : (
                            <p class="practice-empty">
                              {surgeon.noneNote ??
                                "No private consultorio confirmed."}
                            </p>
                          )}
                        </div>
                      </li>
                    ))}
                </ol>
              ) : (
                <p class="clinic-empty">
                  No recommended named surgeon — ask the desk for the operator and volume.
                </p>
              )}
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>

<script is:inline>
  const medifeFilter = document.querySelector("#filter-accepts-medife");
  const listStatus = document.querySelector("#list-status");
  const clinicRows = [...document.querySelectorAll(".clinic")];
  const surgeonCountOf = (row) => Number(row.dataset.surgeonCount || 0);
  const totalClinics = clinicRows.length;
  const totalSurgeons = clinicRows.reduce(
    (count, row) => count + surgeonCountOf(row),
    0,
  );

  const hasEnabledUrlParam = (params, key) => {
    const value = params.get(key);
    return value === "1" || value === "true" || value === "yes";
  };

  const updateFilterUrl = (acceptsMedifeOnly) => {
    const url = new URL(window.location.href);
    url.searchParams.delete("medife");
    if (acceptsMedifeOnly) url.searchParams.set("medife", "1");

    const nextUrl = `${url.pathname}${url.search}${url.hash}`;
    const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (nextUrl !== currentUrl) {
      window.history.replaceState(null, "", nextUrl);
    }
  };

  const applyFilters = ({ syncUrl = true } = {}) => {
    const acceptsMedifeOnly = Boolean(medifeFilter?.checked);
    let visibleClinics = 0;
    let visibleSurgeons = 0;

    for (const row of clinicRows) {
      const accepts = row.dataset.acceptsMedife === "true";
      const visible = !acceptsMedifeOnly || accepts;
      row.hidden = !visible;
      if (visible) {
        visibleClinics += 1;
        visibleSurgeons += surgeonCountOf(row);
      }
    }

    if (listStatus) {
      listStatus.textContent = acceptsMedifeOnly
        ? `Showing ${visibleClinics} clinic${visibleClinics === 1 ? "" : "s"} · ${visibleSurgeons} surgeon${visibleSurgeons === 1 ? "" : "s"} who accept Medifé.`
        : `Showing all ${totalClinics} clinics · ${totalSurgeons} surgeons.`;
    }

    if (syncUrl) updateFilterUrl(acceptsMedifeOnly);
  };

  const applyFiltersFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    if (medifeFilter) {
      medifeFilter.checked = hasEnabledUrlParam(params, "medife");
    }
    applyFilters({ syncUrl: false });
  };

  medifeFilter?.addEventListener("change", () => applyFilters());
  applyFiltersFromUrl();
  window.addEventListener("pageshow", applyFiltersFromUrl);
  window.addEventListener("popstate", applyFiltersFromUrl);
