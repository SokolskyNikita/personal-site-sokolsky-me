    medifeStatus: "verify",
    surgeons: [
      {
        rank: 1,
        name: "Oscar Gural Romero",
        role: "Jefe de flebolinfología",
        practices: [
          {
            name: "Vascular Integral",
            url: "https://vascularintegral.com/",
            address: "Azcuénaga 1860, 5°, Recoleta",
            note: "Moved from Las Heras 3451.",
          },
        ],
      },
    ],
  },
  {
    rank: 7,
    kind: "group",
    name: "Austral, Güemes, Alemán",
    nameLinks: [
      { label: "Austral", href: "https://www.hospitalaustral.edu.ar/" },
      { label: "Güemes", href: "https://sitio.sg.com.ar/" },
      { label: "Alemán", href: "https://www.hospitalaleman.org.ar/" },
    ],
    service: "Thoracic / hybrid desks — no named venous-TOS series",
    url: "https://www.hospitalaustral.edu.ar/",
    location: "Hospital Universitario Austral, Sanatorio Güemes, Hospital Alemán",
    bookingLead:
      "Book via each institution’s thoracic or vascular desk; ask named operator + volume.",
    bookingLinks: [],
    notes:
      "These list TOS capability; no published venous volume and no recommended named operator on this page.",
    medifeLabel: "Verify — site dependent",
    medifeStatus: "verify",
    surgeons: [],
