        practices: [
          {
            name: "Mederis Recoleta",
            url: "https://mederis.com.ar/",
            address: "M.T. de Alvear 1430, 1°, Recoleta",
          },
        ],
      },
      {
        rank: 2,
        name: "Gustavo A. Lyons",
        role: "Jefe de servicio",
        practices: [
          {
            name: "Consultorio particular",
            url: "https://gustavolyons.wixsite.com/home",
            address: "Av. Coronel Díaz 2089, 1° F, Palermo",
            note: "Private / self-pay.",
          },
        ],
      },
      {
        rank: 3,
        name: "Leonardo G. Pankl",
        role: "Staff",
        practices: [
          {
            name: "Centro Médico Martín y Omar",
            url: "https://www.cmmyo.com.ar/",
            address: "Martín y Omar 352, San Isidro",
            note: "Lists Medifé — ask for Pankl.",
          },
        ],
      },
      {
        rank: 4,
        name: "Soledad Olivera López",
        role: "Staff",
        practices: [
          {
            name: "Clínica del Sol",
