          },
        ],
      },
      {
        rank: 4,
        name: "Patricio Zaefferer",
        role: "Consultor (jefe 2003–2021)",
        practices: [
          {
            name: "Instituto Argentino de Flebología",
            url: "https://www.iaflebologia.com/",
            address: "M.T. de Alvear 2320, 2°H / 3°K, Recoleta",
            note: "Ask if he still sees new vascular — not TOS/FRR — patients there.",
          },
        ],
      },
    ],
  },
  {
    rank: 6,
    kind: "hospital",
    name: "Fundación Favaloro",
    service: "Flebolinfología",
    url: "https://www.fundacionfavaloro.org/",
    location: "Av. Belgrano 1746, CABA",
    bookingLead: "Ask the flebolinfología desk.",
    bookingLinks: [
      {
        label: "Flebolinfología",
        href: "https://www.fundacionfavaloro.org/flebolinfologia/",
